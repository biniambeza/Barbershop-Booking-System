    { "bookingId": "book_13", "rating": 5, "comment": "እውነተኛ ክላሲክ ፀጉር ቤት። ቴዎድሮስ በመቀስ ብቻ ያማረ አቆራረጥ ሠራልኝ።", "hoursAfterVisit": 10 },
