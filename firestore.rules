rules_version = '2';

// =====================================================================
// Crown & Blade - Firestore security rules
// =====================================================================
//
// Sign-in is with Google (Firebase Auth). A person is identified by their
// verified Google email, lowercased (myEmail() below). Every signed-in
// person has a profile at users/{uid}, and the `role` stored there is the
// only source of truth for what they may do:
//
//   customer         - books appointments, sees only their own bookings
//   barber           - linked to one barber profile in one shop; manages
//                      their own appointments and availability
//   barbershopOwner  - manages one shop: profile, services, barbers,
//                      all of the shop's bookings
//   admin            - registers / verifies / removes shops, manages users,
//                      plans and subscriptions
//
// Nobody can give themselves a role. A role other than `customer` is only
// granted through an invite at invites/{email} (the invitee's Google email,
// lowercased), created by an admin (any role) or by a shop owner (barbers
// for their own shop). When the invited person signs in with that Google
// account (verified email), the app creates or upgrades their profile from
// the invite and deletes the invite in the same batch.
//
// The profile's `phone` is a contact number the person types in (used for
// bookings, SMS reminders and Chapa). It is not verified and is not part of
// the sign-in identity.
//
// Bootstrap the first admin by creating invites/{their-gmail-lowercased}
// (e.g. invites/someone@gmail.com) in the Firebase console with:
// email (the same lowercased address), role: "admin", name,
// createdBy: "console", createdAt: an ISO-8601 string. Then sign in with
// that Google account.
//
// Cloud Functions (functions/notifications, functions/payments,
// functions/bookings) use the Admin SDK and bypass these rules. Everything they own is read-only (or
// invisible) to clients: payments/*, notificationLog/*, inbox documents
// (except `read`), shop subscription fields, booking payment fields and
// reminder flags.
//
// All instants are ISO-8601 UTC strings ("2026-11-20T07:00:00.000Z").
// Addis Ababa is UTC+3 with no DST.
//
// Collections
//   users/{uid}                uid, email (verified Google email, lowercased;
//                              fixed after create), name, phone (contact,
//                              +2519/+2517...), role, shopId?, barberId?,
//                              createdAt, language? ('en'|'am')
//     /devices/{deviceId}      token, platform, updatedAt   (owner only)
//     /notifications/{id}      title, body, type, bookingId?, paymentId?, read,
//                              createdAt   (functions; owner reads, sets read)
//   invites/{email}            email (== doc id, lowercased), role, name,
//                              shopId?, barberId?, createdBy, createdAt
//   barbershops/{shopId}       ownerId ('' until the invited owner signs
//                              in), name, description, address, city,
//                              subCity?, landmark?, phone, imageUrl, rating,
//                              reviewCount, openingHour, closingHour,
//                              workingDays, isVerified, subscriptionPlan?,
//                              subscriptionStatus?, subscriptionEndsAt?,
//                              createdAt?
//     /services/{serviceId}    shopId, name, description, price (ETB),
//                              durationMinutes
//     /barbers/{barberId}      shopId, name, title, avatarUrl, rating,
//                              reviewCount, isAvailable, email, phone,
//                              specialties, workingDays?, startHour?, endHour?
//       /slotLocks/{lockId}    booking lock: bookingId, startAt, expiresAt
//                              (booking endAt + 1 day); time-off lock:
//                              timeOffId, startAt, expiresAt (time-off endAt
//                              + 1 day). functions/bookings deletes expired
//                              locks daily. No customer data: any signed-in
//                              user can read locks.
//                              lockId = Addis 'yyyyMMdd-HHmm' of a 15-minute
//                              block; one per block a booking/time off covers
//       /timeOff/{timeOffId}   startAt, endAt (quarter hours, one Addis day),
//                              reason?, createdBy, createdAt (owner or that
//                              barber; written in one batch with its locks)
//     /queue/{entryId}         walk-in queue: name, phone?, serviceId?,
//                              barberId?, status, createdAt,
//                              servingStartedAt?, finishedAt?, addedBy, source
//     /queueSummary/current    functions only; public read
//     /reviews/{bookingId}     public read; created once by the booking's
//                              customer; the owner sets reply/replyAt
//     /stats/{yyyy-MM}         functions only; owner/admin read
//     /clients/{customerId}    functions only; owner/admin read
//   Shop policy (owner-editable): cancellationCutoffHours (0..72, default 2),
//   maxReschedules (0..5, default 2). rating/reviewCount on shops and
//   barbers are written by functions/insights only.
//   bookings/{bookingId}       shopId, shopName, barberId, barberName,
//                              customerId, customerName, customerPhone,
//                              serviceId, serviceName, price, date,
//                              timeSlot, status, createdAt, startAt, endAt,
//                              durationMinutes, paymentStatus, paymentMethod,
//                              rescheduleCount? (1..5, absent = 0),
//                              rescheduledAt?,
//                              cancelledBy? ('system' when functions/bookings
//                              cancels it); functions only: paymentId?,
//                              paidAt?, reminder24hSentAt?, reminder2hSentAt?,
//                              cancelReason? ('slot_conflict')
//   insightsApplied/{id}       functions only (no client access)
//   plans/{planId}             name, priceMonthlyEtb, maxBarbers, features,
//                              active   (public read, admin write)
//   payments/{paymentId}       written by functions only; read by the payer,
//                              the shop owner and admins
//   notificationLog/{id}       functions only (no client access)
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Paths
    // -----------------------------------------------------------------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/barbershops/$(shopId);
    }

    function barberPath(shopId, barberId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId);
    }

    function servicePath(shopId, serviceId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/services/$(serviceId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function slotLockPath(shopId, barberId, lockId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId)/slotLocks/$(lockId);
    }

    function timeOffPath(shopId, barberId, timeOffId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId)/timeOff/$(timeOffId);
    }

    // -----------------------------------------------------------------
    // Identity and roles (read from the caller's own users/{uid} doc)
    // -----------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // The caller's verified sign-in email (Google), lowercased, or '' if
    // the token has no email or it is not verified.
    function myEmail() {
      return request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isRole(role) {
      return hasProfile() && me().role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    // Owner of this shop (ownership comes from the owner's profile).
    function isOwnerOf(shopId) {
      return isRole('barbershopOwner') && me().get('shopId', '') == shopId;
    }

    function canManageShop(shopId) {
      return isAdmin() || isOwnerOf(shopId);
    }

    // The shop's owner or one of its barbers.
    function isStaffOf(shopId) {
      return hasProfile() &&
        me().role in ['barbershopOwner', 'barber'] &&
        me().get('shopId', '') == shopId;
    }

    // Signed-in barber linked to this barber profile. Deleting the barber
    // profile revokes the access.
    function isBarberProfile(shopId, barberId) {
      return isRole('barber') &&
        me().get('shopId', '') == shopId &&
        me().get('barberId', '') == barberId &&
        exists(barberPath(shopId, barberId));
    }

    // -----------------------------------------------------------------
    // Generic validators
    // -----------------------------------------------------------------

    function isEthiopianPhone(phone) {
      return phone is string && phone.matches('^[+]251[79][0-9]{8}$');
    }

    // A lowercased email address (invite ids and profile emails).
    function isValidEmail(email) {
      return email is string &&
        email.size() >= 3 && email.size() <= 254 &&
        email.matches('^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$');
    }

    // A business contact number: a mobile (+2519..., +2517...) or a fixed
    // line (+2511... to +2515..., e.g. Addis Ababa +25111...).
    function isEthiopianContactPhone(phone) {
      return phone is string && phone.matches('^[+]251[1-579][0-9]{8}$');
    }

    // Longest service (and so booking) in minutes. A booking writes one
    // slot lock per 15-minute block in its transaction (8 at most), and
    // every lock's rule reads the booking: this keeps the transaction well
    // inside the per-request limits on document reads (20) and expressions.
    // Same value as kMaxServiceDurationMinutes in availability_service.dart.
    function maxServiceMinutes() {
      return 120;
    }

    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Valid if missing, null, or a string within bounds.
    function optString(data, field, minLen, maxLen) {
      return !(field in data) || data[field] == null || isString(data[field], minLen, maxLen);
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 500 && url.matches('^https?://.+');
    }

    function optUrl(data, field) {
      return !(field in data) || data[field] == null || isValidUrl(data[field]);
    }

    function isValidDateString(value) {
      return value is string &&
        value.size() <= 50 &&
        value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*$');
    }

    function isValidDateOrTimestamp(value) {
      return value is timestamp || isValidDateString(value);
    }

    function optDate(data, field) {
      return !(field in data) || isValidDateOrTimestamp(data[field]);
    }

    function optInt(data, field, minValue, maxValue) {
      return !(field in data) ||
        (data[field] is int && data[field] >= minValue && data[field] <= maxValue);
    }

    function optWorkingDays(data) {
      return !('workingDays' in data) ||
        (data.workingDays is list && data.workingDays.size() <= 7 &&
          data.workingDays.hasOnly([1, 2, 3, 4, 5, 6, 7]));
    }

    // True if `field` has the same value before and after the write.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // -----------------------------------------------------------------
    // Time helpers (appointment instants and slot-lock ids)
    // -----------------------------------------------------------------

    // A whole-minute UTC instant exactly as Dart's
    // DateTime.toUtc().toIso8601String() writes it.
    function isUtcMinute(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[.]000Z$');
    }

    // ...on the 15-minute grid (Addis is a whole-hour offset from UTC).
    function isQuarterHour(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:(00|15|30|45):00[.]000Z$');
    }

    // Parses an isUtcMinute string.
    function utcMinuteToTs(s) {
      return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])) +
        duration.value(int(s[11:13]) * 60 + int(s[14:16]), 'm');
    }

    // Slot-lock ids are the Addis wall clock (UTC+3) of the block start,
    // yyyyMMdd-HHmm, on the 15-minute grid. The helpers below avoid
    // ternary padding and timestamp parsing where they can: a 90-minute
    // booking writes seven documents, and all their rules share one budget
    // of 1000 evaluated expressions per request.

    // 'HHmm' of a minute of the day (zero-padded by formatting 1HHmm).
    function hhmm(minuteOfDay) {
      return string(10000 + int((minuteOfDay - minuteOfDay % 60) / 60) * 100 + minuteOfDay % 60)[1:5];
    }

    // The slot-lock id of the block starting at the UTC instant `s`
    // (an isQuarterHour string). Before 21:00 UTC the Addis day is the
    // UTC day, so the id is cut from the string; later blocks (Addis
    // 00:00-02:59) go through timestamp arithmetic.
    function lockIdOf(s) {
      return int(s[11:13]) < 21
        ? s[0:4] + s[5:7] + s[8:10] + '-' + string(103 + int(s[11:13]))[1:3] + s[14:16]
        : addisDayOf(utcMinuteToTs(s) + duration.value(3, 'h')) + '-' +
          hhmm((int(s[11:13]) - 21) * 60 + int(s[14:16]));
    }

    // 'yyyyMMdd' of a timestamp already shifted to Addis time.
    function addisDayOf(a) {
      return string(a.year() * 10000 + a.month() * 100 + a.day());
    }

    // The slot-lock id of the block starting at the UTC timestamp `t`.
    function lockIdOfTs(t) {
      let a = t + duration.value(3, 'h');
      return addisDayOf(a) + '-' + hhmm(a.hours() * 60 + a.minutes());
    }

    // A stored instant (ISO string or legacy timestamp) as a timestamp.
    function instantOf(v) {
      return v is timestamp ? v : utcMinuteToTs(v);
    }

    // -----------------------------------------------------------------
    // Shop booking policy (owner-editable; missing or out-of-range values
    // read as the defaults, like Barbershop.fromMap)
    // -----------------------------------------------------------------

    function policyInt(v, maxValue, def) {
      return (v is int && v >= 0 && v <= maxValue) ? v : def;
    }

    function cutoffHoursOf(shop) {
      return policyInt(shop.get('cancellationCutoffHours', 2), 72, 2);
    }

    function maxReschedulesOf(shop) {
      return policyInt(shop.get('maxReschedules', 2), 5, 2);
    }

    // A booking's shop document (empty map if the shop no longer exists).
    function shopDataOf(shopId) {
      return exists(shopPath(shopId)) ? get(shopPath(shopId)).data : {};
    }

    // The customer may still change the booking `b`: now is at least the
    // shop's cutoff before the start (equality allowed). Legacy bookings
    // without startAt have no cutoff.
    function beforeCutoff(b) {
      return !('startAt' in b) ||
        request.time <= instantOf(b.startAt) - duration.value(cutoffHoursOf(shopDataOf(b.shopId)), 'h');
    }

    // -----------------------------------------------------------------
    // Domain validators
    // -----------------------------------------------------------------

    function isValidUser(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'phone', 'role', 'shopId', 'barberId', 'createdAt', 'language']) &&
        d.keys().hasAll(['uid', 'email', 'name', 'phone', 'role', 'createdAt']) &&
        isString(d.uid, 1, 128) &&
        isValidEmail(d.email) &&
        isString(d.name, 1, 100) &&
        isEthiopianPhone(d.phone) &&
        d.role in ['customer', 'barber', 'barbershopOwner', 'admin'] &&
        optString(d, 'shopId', 1, 128) &&
        optString(d, 'barberId', 1, 128) &&
        (!('language' in d) || d.language in ['en', 'am']) &&
        isValidDateOrTimestamp(d.createdAt) &&
        // Each role carries exactly the links it needs.
        (
          (d.role in ['customer', 'admin'] &&
            d.get('shopId', null) == null && d.get('barberId', null) == null) ||
          (d.role == 'barbershopOwner' &&
            d.get('shopId', null) is string && d.get('barberId', null) == null) ||
          (d.role == 'barber' &&
            d.get('shopId', null) is string && d.get('barberId', null) is string)
        );
    }

    // The role fields in `d` match the caller's own invite, and the same
    // batch deletes that invite (so it can only be used once).
    function matchesMyInvite(d) {
      return myEmail() != '' &&
        exists(invitePath(myEmail())) &&
        get(invitePath(myEmail())).data.role == d.role &&
        get(invitePath(myEmail())).data.get('shopId', null) == d.get('shopId', null) &&
        get(invitePath(myEmail())).data.get('barberId', null) == d.get('barberId', null) &&
        !existsAfter(invitePath(myEmail()));
    }

    // Invite ids are the invitee's lowercased email, repeated in `email`.
    function isValidInvite(d, email) {
      return d.keys().hasOnly(['email', 'role', 'name', 'shopId', 'barberId', 'createdBy', 'createdAt']) &&
        d.keys().hasAll(['email', 'role', 'name', 'createdBy', 'createdAt']) &&
        d.email == email &&
        isValidEmail(email) &&
        isString(d.name, 1, 100) &&
        d.createdBy == request.auth.uid &&
        isValidDateOrTimestamp(d.createdAt) &&
        optString(d, 'shopId', 1, 128) &&
        optString(d, 'barberId', 1, 128) &&
        (
          (d.role == 'admin' &&
            d.get('shopId', null) == null && d.get('barberId', null) == null) ||
          (d.role == 'barbershopOwner' &&
            d.get('shopId', null) is string && d.get('barberId', null) == null &&
            existsAfter(shopPath(d.shopId))) ||
          (d.role == 'barber' &&
            d.get('shopId', null) is string && d.get('barberId', null) is string &&
            existsAfter(barberPath(d.shopId, d.barberId)))
        );
    }

    function isValidBarbershop(d) {
      return d.keys().hasOnly([
          'ownerId', 'name', 'description', 'address', 'city', 'subCity',
          'landmark', 'phone', 'imageUrl', 'rating', 'reviewCount',
          'openingHour', 'closingHour', 'workingDays', 'isVerified',
          'subscriptionPlan', 'subscriptionStatus', 'subscriptionEndsAt',
          'createdAt', 'cancellationCutoffHours', 'maxReschedules'
        ]) &&
        optInt(d, 'cancellationCutoffHours', 0, 72) &&
        optInt(d, 'maxReschedules', 0, 5) &&
        d.keys().hasAll(['ownerId', 'name', 'description', 'address', 'city', 'phone', 'imageUrl']) &&
        isString(d.ownerId, 0, 128) &&
        isString(d.name, 1, 120) &&
        isString(d.description, 1, 1000) &&
        isString(d.address, 1, 200) &&
        isString(d.city, 1, 100) &&
        (!('subCity' in d) || isString(d.subCity, 0, 60)) &&
        optString(d, 'landmark', 0, 200) &&
        isEthiopianContactPhone(d.phone) &&
        isValidUrl(d.imageUrl) &&
        (!('rating' in d) || (d.rating is number && d.rating >= 0 && d.rating <= 5)) &&
        optInt(d, 'reviewCount', 0, 100000000) &&
        optInt(d, 'openingHour', 0, 23) &&
        optInt(d, 'closingHour', 1, 24) &&
        optWorkingDays(d) &&
        (!('isVerified' in d) || d.isVerified is bool) &&
        (!('subscriptionPlan' in d) || d.subscriptionPlan in ['trial', 'basic', 'pro']) &&
        (!('subscriptionStatus' in d) ||
          d.subscriptionStatus in ['trialing', 'active', 'past_due', 'suspended']) &&
        optDate(d, 'subscriptionEndsAt') &&
        optDate(d, 'createdAt');
    }

    // Shop fields only the platform (admin / Cloud Functions) may change.
    function platformShopFields() {
      return ['isVerified', 'rating', 'reviewCount', 'subscriptionPlan',
        'subscriptionStatus', 'subscriptionEndsAt', 'createdAt'];
    }

    // Customers see shops that are not suspended. This must be provable
    // from the customer listener's `subscriptionStatus in [...]` filter,
    // so it reads the field directly: docs without it (written before
    // subscriptions existed) are visible to their staff and admins only.
    function isCustomerVisibleShop(d) {
      return d.subscriptionStatus in ['trialing', 'active', 'past_due'];
    }

    function isValidService(d, shopId) {
      return d.keys().hasOnly(['shopId', 'name', 'description', 'price', 'durationMinutes']) &&
        d.keys().hasAll(['shopId', 'name', 'description', 'price', 'durationMinutes']) &&
        d.shopId == shopId &&
        isString(d.name, 1, 100) &&
        isString(d.description, 1, 500) &&
        d.price is number && d.price >= 0 && d.price <= 100000 &&
        d.durationMinutes is int && d.durationMinutes >= 5 && d.durationMinutes <= maxServiceMinutes();
    }

    function isValidBarber(d, shopId) {
      return d.keys().hasOnly([
          'shopId', 'name', 'title', 'avatarUrl', 'rating', 'reviewCount',
          'isAvailable', 'email', 'phone', 'specialties', 'workingDays',
          'startHour', 'endHour'
        ]) &&
        d.keys().hasAll(['shopId', 'name', 'title']) &&
        d.shopId == shopId &&
        isString(d.name, 1, 100) &&
        isString(d.title, 1, 100) &&
        optUrl(d, 'avatarUrl') &&
        optString(d, 'email', 3, 254) &&
        optString(d, 'phone', 1, 30) &&
        (!('rating' in d) || (d.rating is number && d.rating >= 0 && d.rating <= 5)) &&
        optInt(d, 'reviewCount', 0, 100000000) &&
        (!('isAvailable' in d) || d.isAvailable is bool) &&
        (!('specialties' in d) || (d.specialties is list && d.specialties.size() <= 20)) &&
        optWorkingDays(d) &&
        optInt(d, 'startHour', 0, 23) &&
        optInt(d, 'endHour', 1, 24);
    }

    // Field types shared by every booking document.
    function isBookingCore(d) {
      return isString(d.shopId, 1, 128) &&
        isString(d.shopName, 1, 120) &&
        isString(d.barberId, 1, 128) &&
        isString(d.barberName, 1, 100) &&
        isString(d.customerId, 1, 128) &&
        isString(d.customerName, 1, 100) &&
        isString(d.customerPhone, 1, 30) &&
        isString(d.serviceId, 1, 128) &&
        isString(d.serviceName, 1, 100) &&
        d.price is number && d.price >= 0 && d.price <= 100000 &&
        isValidDateOrTimestamp(d.date) &&
        isString(d.timeSlot, 1, 50) &&
        d.status in ['pending', 'confirmed', 'inProgress', 'completed', 'cancelled', 'noShow'] &&
        isValidDateOrTimestamp(d.createdAt);
    }

    // Shape of any stored booking, including legacy ones without the
    // appointment interval and documents carrying function-written fields.
    function isValidBooking(d) {
      return d.keys().hasOnly([
          'shopId', 'shopName', 'barberId', 'barberName', 'customerId',
          'customerName', 'customerPhone', 'serviceId', 'serviceName',
          'price', 'date', 'timeSlot', 'status', 'createdAt',
          'startAt', 'endAt', 'durationMinutes', 'paymentStatus',
          'paymentMethod', 'cancelledBy', 'rescheduleCount', 'rescheduledAt',
          // Written by Cloud Functions only.
          'paymentId', 'paidAt', 'reminder24hSentAt', 'reminder2hSentAt',
          'cancelReason'
        ]) &&
        d.keys().hasAll([
          'shopId', 'shopName', 'barberId', 'barberName', 'customerId',
          'customerName', 'customerPhone', 'serviceId', 'serviceName',
          'price', 'date', 'timeSlot', 'status', 'createdAt'
        ]) &&
        isBookingCore(d) &&
        optDate(d, 'startAt') &&
        optDate(d, 'endAt') &&
        optInt(d, 'durationMinutes', 5, 480) &&
        (!('paymentStatus' in d) || d.paymentStatus in ['unpaid', 'pending', 'paid', 'refunded']) &&
        (!('paymentMethod' in d) || d.paymentMethod in ['cash', 'chapa']) &&
        optString(d, 'cancelledBy', 1, 128) &&
        optString(d, 'cancelReason', 1, 64) &&
        optInt(d, 'rescheduleCount', 0, 5) &&
        (!('rescheduledAt' in d) || isValidDateString(d.rescheduledAt));
    }

    // The slot lock `id` exists after this write and belongs to the booking.
    function holdsLock(d, bookingId, id) {
      return getAfter(slotLockPath(d.shopId, d.barberId, id)).data.bookingId == bookingId;
    }

    // Offset of the booking's last 15-minute block (start is on the grid).
    function lastBlockOffset(minutes) {
      return (minutes - 1) - ((minutes - 1) % 15);
    }

    // The booking's slot locks, created in the same transaction. `day` is
    // the Addis 'yyyyMMdd-' of the start and `m0` its Addis minute of the
    // day. The first four blocks and the last block are checked (rules
    // have per-request budgets for document reads and expressions); the
    // verifyBookingLocks function (functions/bookings) checks every block
    // after the write and cancels the booking if one is missing.
    function holdsLocks(d, bookingId, day, m0) {
      return holdsLock(d, bookingId, day + hhmm(m0)) &&
        (d.durationMinutes <= 15 || holdsLock(d, bookingId, day + hhmm(m0 + 15))) &&
        (d.durationMinutes <= 30 || holdsLock(d, bookingId, day + hhmm(m0 + 30))) &&
        (d.durationMinutes <= 45 || holdsLock(d, bookingId, day + hhmm(m0 + 45))) &&
        (lastBlockOffset(d.durationMinutes) <= 45 ||
          holdsLock(d, bookingId, day + hhmm(m0 + lastBlockOffset(d.durationMinutes))));
    }

    // The appointment interval: endAt = startAt + durationMinutes, starting
    // in the next 31 days and ending by Addis midnight; and its slot locks
    // are held.
    function isValidInterval(d, bookingId) {
      let start = utcMinuteToTs(d.startAt);
      let a = start + duration.value(3, 'h');
      let m0 = a.hours() * 60 + a.minutes();
      return utcMinuteToTs(d.endAt) == start + duration.value(d.durationMinutes, 'm') &&
        start > request.time &&
        start < request.time + duration.value(31, 'd') &&
        m0 + d.durationMinutes <= 1440 &&
        holdsLocks(d, bookingId, addisDayOf(a) + '-', m0);
    }

    // A new booking from the app.
    function isValidNewBooking(d, bookingId) {
      return d.keys().hasOnly([
          'shopId', 'shopName', 'barberId', 'barberName', 'customerId',
          'customerName', 'customerPhone', 'serviceId', 'serviceName',
          'price', 'date', 'timeSlot', 'status', 'createdAt',
          'startAt', 'endAt', 'durationMinutes', 'paymentStatus',
          'paymentMethod'
        ]) &&
        d.keys().size() == 19 &&
        d.shopName is string && d.shopName.size() <= 120 &&
        d.barberName is string && d.barberName.size() <= 100 &&
        d.customerName is string && d.customerName.size() <= 100 &&
        d.customerPhone is string && d.customerPhone.size() <= 30 &&
        d.serviceName is string && d.serviceName.size() <= 100 &&
        d.timeSlot is string && d.timeSlot.size() <= 50 &&
        isValidDateString(d.date) &&
        isValidDateString(d.createdAt) &&
        d.status in ['pending', 'confirmed'] &&
        d.paymentStatus == 'unpaid' &&
        d.paymentMethod in ['cash', 'chapa'] &&
        d.durationMinutes is int &&
        d.durationMinutes <= maxServiceMinutes() &&
        isQuarterHour(d.startAt) &&
        isUtcMinute(d.endAt) &&
        isValidInterval(d, bookingId);
    }

    // A booking may only reference a bookable shop, an available barber
    // and a real service, at that service's price and duration.
    //
    // Document reads of a booking create, worst case: the caller's profile,
    // five slot locks, shop, barber and service = 9 (limit 10 per document
    // write, 20 per transaction; each of the at most 8 lock writes reads
    // the booking once more: 17 even if nothing is shared).
    function isBookable(d) {
      let svc = get(servicePath(d.shopId, d.serviceId)).data;
      return get(shopPath(d.shopId)).data.get('subscriptionStatus', 'trialing') != 'suspended' &&
        get(barberPath(d.shopId, d.barberId)).data.get('isAvailable', true) == true &&
        svc.price == d.price &&
        svc.durationMinutes == d.durationMinutes;
    }

    // cancelledBy is only set by the person cancelling, on the transition
    // to cancelled.
    function cancelledByOk() {
      return !changedKeys().hasAny(['cancelledBy']) ||
        (request.resource.data.status == 'cancelled' &&
          resource.data.status != 'cancelled' &&
          request.resource.data.cancelledBy == request.auth.uid);
    }

    // A lock for a block inside a live booking of the caller's, at this
    // shop and barber. The booking may be created in the same transaction.
    // The lock is bound to its booking through getAfter(booking) and holds
    // no customer data (any signed-in user can read locks). expiresAt is
    // the booking's end plus one day, for the cleanup job.
    // Kept lean: a 120-minute booking writes eight locks, and every write
    // of the transaction shares one budget of evaluated expressions.
    // (Reading bookingId, startAt and expiresAt fails if one is missing,
    // so hasOnly is enough for the shape.)
    function canCreateSlotLock(shopId, barberId, lockId, d) {
      let bk = getAfter(bookingPath(d.bookingId)).data;
      return d.keys().hasOnly(['bookingId', 'startAt', 'expiresAt']) &&
        bk.customerId == request.auth.uid &&
        bk.shopId == shopId &&
        bk.barberId == barberId &&
        bk.status in ['pending', 'confirmed'] &&
        isQuarterHour(d.startAt) &&
        d.startAt >= bk.startAt &&
        d.startAt < bk.endAt &&
        lockId == lockIdOf(d.startAt) &&
        isUtcMinute(d.expiresAt) &&
        utcMinuteToTs(d.expiresAt) == utcMinuteToTs(bk.endAt) + duration.value(1, 'd');
    }

    // Releasing a booking lock: its booking is cancelled (now or earlier)
    // and the caller is someone who may cancel that booking; or the
    // booking's customer released a block the booking no longer covers
    // (a reschedule: the lock's block is outside the booking's interval
    // after this write, and the booking is still live).
    function canReleaseSlotLock(shopId, barberId) {
      let bk = getAfter(bookingPath(resource.data.bookingId)).data;
      return bk.shopId == shopId &&
        bk.barberId == barberId &&
        (
          (bk.status == 'cancelled' &&
            (bk.customerId == request.auth.uid || isBarberProfile(shopId, barberId))) ||
          (bk.customerId == request.auth.uid &&
            bk.status in ['pending', 'confirmed'] &&
            (resource.data.startAt < bk.startAt || resource.data.startAt >= bk.endAt))
        );
    }

    // A time-off lock: the block lies inside the time-off range of the
    // same barber, written in the same batch (bound through getAfter), by
    // the owner or that barber. Up to 96 of these share one request, so
    // the cheap shape checks come first.
    function canCreateTimeOffLock(shopId, barberId, lockId, d) {
      let t = getAfter(timeOffPath(shopId, barberId, d.timeOffId)).data;
      return d.keys().hasOnly(['timeOffId', 'startAt', 'expiresAt']) &&
        isQuarterHour(d.startAt) &&
        d.startAt >= t.startAt &&
        d.startAt < t.endAt &&
        isUtcMinute(d.expiresAt) &&
        utcMinuteToTs(d.expiresAt) == utcMinuteToTs(t.endAt) + duration.value(1, 'd') &&
        lockId == lockIdOf(d.startAt) &&
        canManageTimeOff(shopId, barberId);
    }

    // The owner of the shop or that barber (admins do not manage time off).
    function canManageTimeOff(shopId, barberId) {
      return isOwnerOf(shopId) || isBarberProfile(shopId, barberId);
    }

    // The time-off lock of the block starting at timestamp `t` exists after
    // this write and belongs to `timeOffId`.
    function holdsTimeOffLock(shopId, barberId, timeOffId, t) {
      return getAfter(slotLockPath(shopId, barberId, lockIdOfTs(t))).data.get('timeOffId', '') == timeOffId;
    }

    // The time-off lock of the block at `t` is gone (or was reused) after
    // this write.
    function releasedTimeOffLock(shopId, barberId, timeOffId, t) {
      let p = slotLockPath(shopId, barberId, lockIdOfTs(t));
      return !existsAfter(p) || getAfter(p).data.get('timeOffId', '') != timeOffId;
    }

    // A new time-off range: quarter hours, end after start, within one
    // Addis day (end at most the next Addis midnight), not over yet, and
    // its first and last blocks locked in the same batch (the locks rule
    // checks each lock against this document).
    function isValidNewTimeOff(shopId, barberId, timeOffId, d) {
      let s = utcMinuteToTs(d.startAt);
      let e = utcMinuteToTs(d.endAt);
      let a = s + duration.value(3, 'h');
      let m0 = a.hours() * 60 + a.minutes();
      return d.keys().hasOnly(['startAt', 'endAt', 'reason', 'createdBy', 'createdAt']) &&
        d.keys().hasAll(['startAt', 'endAt', 'createdBy', 'createdAt']) &&
        timeOffId.size() <= 128 &&
        isQuarterHour(d.startAt) &&
        isQuarterHour(d.endAt) &&
        e > s &&
        e.toMillis() - s.toMillis() <= (1440 - m0) * 60000 &&
        e > request.time &&
        (!('reason' in d) || isString(d.reason, 1, 200)) &&
        d.createdBy == request.auth.uid &&
        isValidDateString(d.createdAt) &&
        holdsTimeOffLock(shopId, barberId, timeOffId, s) &&
        holdsTimeOffLock(shopId, barberId, timeOffId, e - duration.value(15, 'm'));
    }

    // A booking's status transition. noShow is set only from pending or
    // confirmed, once the appointment has started, and is final (only the
    // admin's payment correction may touch such a booking).
    function statusTransitionOk() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (from == 'noShow' && to == 'noShow') ||
        (from != 'noShow' && to != 'noShow') ||
        (from in ['pending', 'confirmed'] && to == 'noShow' &&
          'startAt' in resource.data &&
          request.time >= instantOf(resource.data.startAt));
    }

    // The customer moves their booking (same barber, service, duration and
    // price): exactly startAt, endAt, date, timeSlot, rescheduleCount (+1,
    // up to the shop's maxReschedules) and rescheduledAt change, before the
    // shop's cutoff for the CURRENT start; the new interval is valid as on
    // create and holds its slot locks (checked through getAfter).
    function isValidReschedule(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      let shop = shopDataOf(r.shopId);
      return changedKeys().hasOnly(['startAt', 'endAt', 'date', 'timeSlot', 'rescheduleCount', 'rescheduledAt']) &&
        r.customerId == request.auth.uid &&
        r.status in ['pending', 'confirmed'] &&
        d.get('rescheduleCount', -1) is int &&
        d.rescheduleCount == r.get('rescheduleCount', 0) + 1 &&
        d.rescheduleCount <= maxReschedulesOf(shop) &&
        'startAt' in r &&
        request.time <= instantOf(r.startAt) - duration.value(cutoffHoursOf(shop), 'h') &&
        isValidDateString(d.date) &&
        isString(d.timeSlot, 1, 50) &&
        isValidDateString(d.get('rescheduledAt', null)) &&
        d.durationMinutes is int &&
        d.durationMinutes <= maxServiceMinutes() &&
        isQuarterHour(d.startAt) &&
        isUtcMinute(d.endAt) &&
        isValidInterval(d, bookingId);
    }

    // -----------------------------------------------------------------
    // Walk-in queue
    // -----------------------------------------------------------------

    // The shop's owner, or a barber of the shop whose profile still exists.
    function isQueueStaffOf(shopId) {
      return isOwnerOf(shopId) ||
        (isRole('barber') && me().get('shopId', '') == shopId &&
          exists(barberPath(shopId, me().get('barberId', ''))));
    }

    function isValidNewQueueEntry(shopId, d) {
      return d.keys().hasOnly(['name', 'phone', 'serviceId', 'barberId', 'status', 'createdAt', 'addedBy', 'source']) &&
        d.keys().hasAll(['name', 'status', 'createdAt', 'addedBy', 'source']) &&
        isString(d.name, 1, 60) &&
        (!('phone' in d) || isEthiopianPhone(d.phone)) &&
        (!('serviceId' in d) || (isString(d.serviceId, 1, 128) && exists(servicePath(shopId, d.serviceId)))) &&
        (!('barberId' in d) || (isString(d.barberId, 1, 128) && exists(barberPath(shopId, d.barberId)))) &&
        d.status == 'waiting' &&
        isValidDateString(d.createdAt) &&
        d.addedBy == request.auth.uid;
    }

    // waiting -> left, or serving -> done: {status, finishedAt}.
    function isQueueFinish(from, to) {
      return changedKeys().hasOnly(['status', 'finishedAt']) &&
        resource.data.status == from &&
        request.resource.data.status == to &&
        isValidDateString(request.resource.data.get('finishedAt', null));
    }

    // waiting -> serving with a barber of the shop.
    function isQueueStartServing(shopId) {
      let d = request.resource.data;
      return changedKeys().hasOnly(['status', 'barberId', 'servingStartedAt']) &&
        resource.data.status == 'waiting' &&
        d.status == 'serving' &&
        d.get('barberId', null) is string &&
        exists(barberPath(shopId, d.barberId)) &&
        isValidDateString(d.get('servingStartedAt', null));
    }

    // -----------------------------------------------------------------
    // Reviews
    // -----------------------------------------------------------------

    // One review per completed booking (doc id = bookingId), by its
    // customer, copying the booking's shop, barber and customer name.
    function isValidNewReview(shopId, reviewId, d) {
      let b = get(bookingPath(reviewId)).data;
      return d.keys().hasOnly(['bookingId', 'shopId', 'barberId', 'customerId', 'customerName', 'rating', 'comment', 'createdAt']) &&
        d.keys().hasAll(['bookingId', 'shopId', 'barberId', 'customerId', 'customerName', 'rating', 'createdAt']) &&
        d.bookingId == reviewId &&
        d.shopId == shopId &&
        d.customerId == request.auth.uid &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        (!('comment' in d) || isString(d.comment, 1, 500)) &&
        isValidDateString(d.createdAt) &&
        b.customerId == request.auth.uid &&
        b.status == 'completed' &&
        b.shopId == shopId &&
        b.barberId == d.barberId &&
        b.customerName == d.customerName;
    }

    function isValidPlan(d) {
      return d.keys().hasOnly(['name', 'priceMonthlyEtb', 'maxBarbers', 'features', 'active']) &&
        d.keys().hasAll(['name', 'priceMonthlyEtb', 'maxBarbers', 'features', 'active']) &&
        isString(d.name, 1, 60) &&
        d.priceMonthlyEtb is number && d.priceMonthlyEtb >= 0 && d.priceMonthlyEtb <= 1000000 &&
        d.maxBarbers is int && d.maxBarbers >= -1 && d.maxBarbers <= 1000 &&
        d.features is list && d.features.size() <= 30 &&
        d.active is bool;
    }

    function isValidDevice(d) {
      return d.keys().hasOnly(['token', 'platform', 'updatedAt']) &&
        d.keys().hasAll(['token', 'platform', 'updatedAt']) &&
        isString(d.token, 1, 4096) &&
        d.platform in ['android', 'ios', 'web'] &&
        isValidDateString(d.updatedAt);
    }

    // -----------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------
    match /users/{userId} {
      // Own profile; admins see everyone; owners see their shop's staff.
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.get('shopId', null) is string && isOwnerOf(resource.data.shopId))
      );

      // First sign-in: create your own profile with your verified Google
      // email (lowercased) and a contact phone you type in. The role is
      // `customer`, or whatever your invite says.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        isValidUser(request.resource.data) &&
        request.resource.data.uid == userId &&
        myEmail() != '' &&
        request.resource.data.email == myEmail() &&
        (request.resource.data.role == 'customer' || matchesMyInvite(request.resource.data));

      allow update: if signedIn() && isValidUser(request.resource.data) && (
        isAdmin() ||
        (request.auth.uid == userId &&
          unchanged('uid') && unchanged('createdAt') && unchanged('email') &&
          (
            // Ordinary profile edits: name, language, contact phone.
            changedKeys().hasOnly(['name', 'language', 'phone']) ||
            // ...or a customer accepting an invite (one time).
            (resource.data.role == 'customer' && matchesMyInvite(request.resource.data))
          ))
      );

      allow delete: if isAdmin();

      // FCM registration tokens of this user's devices.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          deviceId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          isValidDevice(request.resource.data);
      }

      // In-app inbox, written by Cloud Functions. The user may only mark
      // a notification as read.
      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() &&
          request.auth.uid == userId &&
          changedKeys().hasOnly(['read']) &&
          request.resource.data.read == true;
      }
    }

    // -----------------------------------------------------------------
    // invites/{email}
    // -----------------------------------------------------------------
    match /invites/{email} {
      allow read: if signedIn() && (
        (myEmail() != '' && myEmail() == email) ||
        isAdmin() ||
        (resource.data.role == 'barber' && isOwnerOf(resource.data.shopId))
      );

      allow create: if signedIn() &&
        isValidInvite(request.resource.data, email) &&
        (
          isAdmin() ||
          (request.resource.data.role == 'barber' && isOwnerOf(request.resource.data.shopId))
        );

      // Owners may only replace their own shop's barber invites.
      allow update: if signedIn() &&
        isValidInvite(request.resource.data, email) &&
        (
          isAdmin() ||
          (request.resource.data.role == 'barber' && isOwnerOf(request.resource.data.shopId) &&
            resource.data.role == 'barber' && isOwnerOf(resource.data.shopId))
        );

      // The invitee (accepting/declining), an admin, or the shop owner
      // (cancelling a barber invite).
      allow delete: if signedIn() && (
        (myEmail() != '' && myEmail() == email) ||
        isAdmin() ||
        (resource.data.role == 'barber' && isOwnerOf(resource.data.shopId))
      );
    }

    // -----------------------------------------------------------------
    // Collection-group reads (customer and admin listeners). Services and
    // barber profiles are public, like the nested rules below. These do
    // not match slotLocks (a different collection id).
    // -----------------------------------------------------------------
    match /{path=**}/services/{serviceId} {
      allow read: if true;
    }

    match /{path=**}/barbers/{barberId} {
      allow read: if true;
    }

    // -----------------------------------------------------------------
    // barbershops/{shopId}
    // -----------------------------------------------------------------
    match /barbershops/{shopId} {
      // Public directory of shops that are not suspended. A suspended shop
      // stays visible to its own staff and to admins.
      allow read: if isCustomerVisibleShop(resource.data) || isAdmin() || isStaffOf(shopId);

      // Shops are onboarded by the platform admin, with no reviews yet.
      allow create: if isAdmin() && isValidBarbershop(request.resource.data) &&
        request.resource.data.get('reviewCount', 0) == 0;

      // Owners edit their shop's profile and booking policy
      // (cancellationCutoffHours, maxReschedules) but cannot verify it,
      // change its rating or its subscription. They can claim an unowned
      // shop (ownerId '') once. rating/reviewCount are written by
      // functions/insights only, so not even the admin changes them.
      allow update: if isValidBarbershop(request.resource.data) && (
        (isAdmin() && !changedKeys().hasAny(['rating', 'reviewCount'])) ||
        (isOwnerOf(shopId) &&
          !changedKeys().hasAny(platformShopFields()) &&
          (unchanged('ownerId') ||
            (resource.data.ownerId == '' && request.resource.data.ownerId == request.auth.uid)))
      );

      allow delete: if isAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow create: if canManageShop(shopId) && isValidService(request.resource.data, shopId);
        allow update: if canManageShop(shopId) && isValidService(request.resource.data, shopId);
        allow delete: if canManageShop(shopId);
      }

      match /barbers/{barberId} {
        allow read: if true;

        // New barbers have no reviews yet.
        allow create: if canManageShop(shopId) && isValidBarber(request.resource.data, shopId) &&
          request.resource.data.get('reviewCount', 0) == 0;

        // rating/reviewCount are written by functions/insights only.
        allow update: if isValidBarber(request.resource.data, shopId) && (
          (isAdmin() && !changedKeys().hasAny(['rating', 'reviewCount'])) ||
          // Owners manage profiles and working hours but not ratings.
          (isOwnerOf(shopId) && !changedKeys().hasAny(['rating', 'reviewCount'])) ||
          // A barber can only toggle their own availability.
          (isBarberProfile(shopId, barberId) && changedKeys().hasOnly(['isAvailable']))
        );

        allow delete: if canManageShop(shopId);

        // Double-booking prevention: one lock per 15-minute block of a
        // booking, created in the same transaction as the booking. Locks
        // are never updated, so a second booking for a taken block fails.
        match /slotLocks/{lockId} {
          // The booking screen reads a day's locks to show busy times.
          // Locks hold only a booking id and two instants.
          allow read: if signedIn();

          // Booking locks (bookingId) and time-off locks (timeOffId).
          allow create: if signedIn() && (
            'timeOffId' in request.resource.data
              ? canCreateTimeOffLock(shopId, barberId, lockId, request.resource.data)
              : canCreateSlotLock(shopId, barberId, lockId, request.resource.data)
          );

          allow update: if false;

          // Released when the booking is cancelled or moved; owners and
          // admins may clear their shop's locks at any time; the barber
          // releases their time-off locks together with the time-off doc.
          allow delete: if signedIn() && (
            ('bookingId' in resource.data && canReleaseSlotLock(shopId, barberId)) ||
            ('timeOffId' in resource.data &&
              isBarberProfile(shopId, barberId) &&
              !existsAfter(timeOffPath(shopId, barberId, resource.data.timeOffId))) ||
            canManageShop(shopId)
          );
        }

        // Barber time off. Created and deleted in one batch with its slot
        // locks, by the shop's owner or that barber. Customers never read
        // it (they see the locks).
        match /timeOff/{timeOffId} {
          allow read: if canManageTimeOff(shopId, barberId);

          allow create: if canManageTimeOff(shopId, barberId) &&
            isValidNewTimeOff(shopId, barberId, timeOffId, request.resource.data);

          allow update: if false;

          // Its first and last locks go in the same batch (the app deletes
          // every lock with timeOffId == this id).
          allow delete: if canManageTimeOff(shopId, barberId) &&
            releasedTimeOffLock(shopId, barberId, timeOffId, utcMinuteToTs(resource.data.startAt)) &&
            releasedTimeOffLock(shopId, barberId, timeOffId,
              utcMinuteToTs(resource.data.endAt) - duration.value(15, 'm'));
        }
      }

      // Walk-in queue. Staff (owner, barbers of the shop) run it; signed-in
      // customers may join remotely with their own phone and leave their
      // own waiting entry. Entries are never deleted.
      match /queue/{entryId} {
        allow read: if signedIn() && (
          resource.data.addedBy == request.auth.uid ||
          isQueueStaffOf(shopId)
        );

        allow create: if signedIn() &&
          isValidNewQueueEntry(shopId, request.resource.data) &&
          (
            (request.resource.data.source == 'walkIn' && isQueueStaffOf(shopId)) ||
            (request.resource.data.source == 'remote' &&
              isRole('customer') &&
              (!('phone' in request.resource.data) || request.resource.data.phone == me().phone) &&
              shopDataOf(shopId).get('subscriptionStatus', 'trialing') != 'suspended' &&
              exists(shopPath(shopId)))
          );

        allow update: if signedIn() && (
          (resource.data.addedBy == request.auth.uid &&
            resource.data.source == 'remote' &&
            isQueueFinish('waiting', 'left')) ||
          (isQueueStaffOf(shopId) &&
            (isQueueStartServing(shopId) ||
              isQueueFinish('serving', 'done') ||
              isQueueFinish('waiting', 'left')))
        );

        allow delete: if false;
      }

      // Maintained by functions/queue; public.
      match /queueSummary/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Public reviews. The booking's customer creates one per completed
      // booking (doc id = bookingId); customers cannot edit or delete it.
      // The shop's owner may only add or edit the reply.
      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn() &&
          isValidNewReview(shopId, reviewId, request.resource.data);

        allow update: if isOwnerOf(shopId) &&
          changedKeys().hasOnly(['reply', 'replyAt']) &&
          isString(request.resource.data.get('reply', null), 1, 500) &&
          isValidDateString(request.resource.data.get('replyAt', null));

        allow delete: if false;
      }

      // Aggregates written by functions/insights only.
      match /stats/{month} {
        allow read: if canManageShop(shopId);
        allow write: if false;
      }

      match /clients/{customerId} {
        allow read: if canManageShop(shopId);
        allow write: if false;
      }
    }

    // -----------------------------------------------------------------
    // bookings/{bookingId}
    // -----------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        canManageShop(resource.data.shopId) ||
        isBarberProfile(resource.data.shopId, resource.data.barberId)
      );

      // Customers book for themselves, with an available barber and a
      // service of a non-suspended shop, at the service's real price and
      // duration, holding the slot locks for the appointment.
      allow create: if hasProfile() &&
        request.resource.data.customerId == request.auth.uid &&
        isValidNewBooking(request.resource.data, bookingId) &&
        isBookable(request.resource.data);

      // Only the status (plus who cancelled) changes after booking.
      // Payment fields and reminder flags belong to Cloud Functions; an
      // admin may also correct paymentStatus.
      //
      // noShow: set by the assigned barber, the owner or an admin once the
      // appointment has started, from pending/confirmed only (see
      // statusTransitionOk); its slot locks are kept.
      //
      // The customer may also move the booking (isValidReschedule), in one
      // transaction with its slot locks.
      //
      // The reschedule branch comes first and validates only the fields it
      // may change (the rest is unchanged): it shares one budget of 1000
      // evaluated expressions with up to 16 slot-lock writes, and
      // isValidBooking's key lists alone would use a large part of it.
      allow update: if signedIn() && (
        isValidReschedule(bookingId) || (
        isValidBooking(request.resource.data) &&
        cancelledByOk() &&
        statusTransitionOk() &&
        (
          (changedKeys().hasOnly(['status', 'cancelledBy']) &&
            (
              // Customer: cancel an upcoming booking, before the shop's
              // cancellation cutoff.
              (resource.data.customerId == request.auth.uid &&
                resource.data.status in ['pending', 'confirmed'] &&
                request.resource.data.status == 'cancelled' &&
                beforeCutoff(resource.data)) ||
              // Assigned barber or shop owner: run the shop's queue. A
              // cancelled booking has released its slot, so it stays
              // cancelled.
              ((isBarberProfile(resource.data.shopId, resource.data.barberId) ||
                  isOwnerOf(resource.data.shopId)) &&
                (resource.data.status != 'cancelled' || request.resource.data.status == 'cancelled')) ||
              isAdmin()
            )) ||
          (changedKeys().hasOnly(['status', 'cancelledBy', 'paymentStatus']) && isAdmin())
        )));

      // Bookings are kept for history.
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // plans/{planId} - subscription plans
    // -----------------------------------------------------------------
    match /plans/{planId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPlan(request.resource.data);
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // payments/{paymentId} - written by Cloud Functions only
    // -----------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        canManageShop(resource.data.shopId)
      );
      allow write: if false;
    }

    // notificationLog/* and everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
