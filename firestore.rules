rules_version = '2';

// =====================================================================
// Crown & Blade - Firestore security rules
// =====================================================================
//
// Sign-in is with Google or with email + password (Firebase Auth). Email
// accounts are created by functions/auth only after a 6-digit code sent to
// the address is confirmed, so they are created with a verified email. A
// person is identified by their verified sign-in email, lowercased
// (myEmail() below). Every signed-in
// person has a profile at users/{uid}, and the `role` stored there is the
// only source of truth for what they may do:
//
//   customer         - books appointments, sees only their own bookings
//   barber           - linked to one barber profile in one shop; manages
//                      their own appointments and availability
//   barbershopOwner  - manages one shop: profile, services, barbers,
//                      all of the shop's bookings
//   admin            - registers / verifies / removes shops, manages users,
//                      plans and subscriptions
//
// Nobody can give themselves a role. A role other than `customer` is only
// granted through an invite at invites/{email} (the invitee's Google email,
// lowercased), created by an admin (any role) or by a shop owner (barbers
// for their own shop). When the invited person signs in with that Google
// account (verified email), the app creates or upgrades their profile from
// the invite and deletes the invite in the same batch.
//
// The profile's `phone` is a contact number the person types in (used for
// bookings, SMS reminders and Chapa). It is not verified and is not part of
// the sign-in identity.
//
// Bootstrap the first admin by creating invites/{their-gmail-lowercased}
// (e.g. invites/someone@gmail.com) in the Firebase console with:
// email (the same lowercased address), role: "admin", name,
// createdBy: "console", createdAt: an ISO-8601 string. Then sign in with
// that Google account.
//
// Cloud Functions (functions/notifications, functions/payments,
// functions/bookings, functions/auth) use the Admin SDK and bypass these rules. Everything they own is read-only (or
// invisible) to clients: payments/*, notificationLog/*, inbox documents
// (except `read`), shop subscription fields, booking payment fields and
// reminder flags.
//
// All instants are ISO-8601 UTC strings ("2026-11-20T07:00:00.000Z").
// Addis Ababa is UTC+3 with no DST.
//
// Collections
//   users/{uid}                uid, email (verified Google email, lowercased;
//                              fixed after create), name, phone (contact,
//                              +2519/+2517...), role, shopId?, barberId?,
//                              createdAt, language? ('en'|'am'),
//                              mustChangePassword? (bool; owner-created barber
//                              logins: the user may only clear it),
//                              disabled?, disabledAt?, disabledBy?,
//                              disabledReason? (admin only; a disabled
//                              account creates no bookings, reviews, queue
//                              joins or shop applications)
//     /devices/{deviceId}      token, platform, updatedAt   (owner only)
//     /notifications/{id}      title, body, type, bookingId?, paymentId?, read,
//                              createdAt   (functions; owner reads, sets read).
//                              Client-created kinds (isValidNewNotice):
//                              early finish {bookingId}_early_{sourceBookingId}
//                              (staff), receipt decisions {paymentId}_receipt
//                              (admin), refunds {bookingId}_refundDue /
//                              _paymentRefunded, new reviews (owner's inbox),
//                              staff cancels {bookingId}_cancelled, admin
//                              clean-up (shopDeleted, shopRemoved,
//                              accountDisabled)
//   invites/{email}            email (== doc id, lowercased), role, name,
//                              shopId?, barberId?, createdBy, createdAt,
//                              authUid? (barber invites: the uid of the login
//                              the owner created), mustChangePassword? (bool)
//   barbershops/{shopId}       ownerId ('' until the invited owner signs
//                              in), name, description, address, city,
//                              subCity?, landmark?, phone, imageUrl, rating,
//                              reviewCount, openingHour, closingHour,
//                              workingDays, isVerified, subscriptionPlan?,
//                              subscriptionStatus?, subscriptionEndsAt?,
//                              subscriptionStatusChangedAt? (ISO; written
//                              with a downgrade by the owner's app on the
//                              free plan, see isSubscriptionLapse, or by an
//                              admin),
//                              createdAt?, requireBarberAcceptance? (bool,
//                              absent = false: new bookings are 'pending'
//                              until the barber/owner accepts),
//                              admin only: adminSuspended? (bool; true = no
//                              new bookings or remote queue joins),
//                              adminSuspendedReason? (1..300),
//                              adminSuspendedAt? (ISO), adminSuspendedBy?
//                              (admin uid), subscriptionReceiptId? (the
//                              subscriptionPayments doc that last extended
//                              the subscription; set in the approval batch)
//     /services/{serviceId}    shopId, name, description, price (ETB),
//                              durationMinutes
//     /barbers/{barberId}      shopId, name, title, avatarUrl, rating
//                              (legacy average), reviewCount, ratingSum?
//                              (sum of the stars; absent on legacy docs =
//                              round(rating * reviewCount)), lastReviewId?
//                              (the review that last changed the counters),
//                              isAvailable, email?, phone? (legacy only: new
//                              docs have neither; they may only be removed),
//                              specialties, workingDays?, startHour?, endHour?,
//                              commissionPercent? (int 0..100, absent = 50;
//                              owner only)
//       /slotLocks/{lockId}    booking lock: bookingId, startAt, expiresAt
//                              (booking endAt + 1 day); time-off lock:
//                              timeOffId, startAt, expiresAt (time-off endAt
//                              + 1 day). functions/bookings deletes expired
//                              locks daily. No customer data: any signed-in
//                              user can read locks.
//                              lockId = Addis 'yyyyMMdd-HHmm' of a 15-minute
//                              block; one per block a booking/time off covers
//       /timeOff/{timeOffId}   startAt, endAt (quarter hours, one Addis day),
//                              reason?, createdBy, createdAt, groupId?,
//                              groupFrom?, groupTo? (a vacation: one doc per
//                              day) (owner or that barber; written in one
//                              batch with its locks)
//       /private/contact       phone (the barber's; owner, admins and that
//                              barber only)
//     /queue/{entryId}         walk-in queue: name, phone?, serviceId?,
//                              barberId?, status, createdAt,
//                              servingStartedAt?, finishedAt?, addedBy, source
//     /queueSummary/current    public read; functions/queue, or (free
//                              plan) the shop's staff with the same shape
//     /reviews/{bookingId}     public read; created once by the booking's
//                              customer, in the same transaction that adds
//                              its stars to the barber's ratingSum /
//                              reviewCount; the customer may edit (rating,
//                              comment, editedAt) or delete it, again with
//                              the counters; the owner sets reply/replyAt
//     /stats/{yyyy-MM}         functions only; owner/admin read
//     /clients/{customerId}    functions only; owner/admin read
//     /payouts/{payoutId}      barberId, amount (0 < ETB <= 1,000,000),
//                              periodStart, periodEnd (UTC-midnight ISO),
//                              method, note?, createdBy, createdAt (ISO).
//                              Owner creates; owner deletes within 24 h of
//                              createdAt; never updated. Read by the owner,
//                              admins and the barber it pays.
//   Shop policy (owner-editable): cancellationCutoffHours (0..72, default 2),
//   maxReschedules (0..5, default 2). Barber ratingSum/reviewCount change
//   only with a new review (isReviewCounterUpdate); shop rating/reviewCount
//   are a cache written by functions/insights only (the app computes the
//   shop rating from its barbers).
//   bookings/{bookingId}       shopId, shopName, barberId, barberName,
//                              customerId, customerName, customerPhone,
//                              serviceId, serviceName, price, date,
//                              timeSlot, status, createdAt, startAt, endAt,
//                              durationMinutes, paymentStatus, paymentMethod,
//                              rescheduleCount? (1..5, absent = 0),
//                              rescheduledAt?,
//                              cancelledBy? (a uid; 'barber'/'owner' when a
//                              booking request is declined; 'system' when
//                              functions/bookings cancels it),
//                              acceptedAt? (request accepted), declineReason?
//                              (1..200), cancelReasonNote? (1..200, staff
//                              cancel only, see isBookingCancel), completedAt?
//                              (ISO, written with status 'completed' by
//                              staff, see isCompleteBooking); functions only: paymentId?,
//                              paidAt?, reminder24hSentAt?, reminder2hSentAt?,
//                              cancelReason? ('slot_conflict', 'not_accepted';
//                              admin clean-up: 'shop_deleted',
//                              'account_disabled'), barberPhone? (staff, see
//                              isBarberPhoneShare), refund state (see
//                              refundFlagOk / isRefundBookkeeping):
//                              refundStatus ('due'|'refunded'), refundAmount,
//                              refundReason, refundFlaggedAt, refundedAt?,
//                              refundedBy?, refundMethod?, refundReference?
//   shopApplications/{uid}     a customer's request to register a shop: uid,
//                              email, ownerName, shopName, address, subCity,
//                              phone, description?, status ('pending' |
//                              'approved' | 'rejected'), createdAt; set by
//                              the admin: reviewedBy, reviewedAt, shopId?
//                              (approved), rejectReason? (rejected)
//   shopDeletions/{shopId}     an admin's shop deletion in progress (see the
//                              match)
//   insightsApplied/{id}       functions only (no client access)
//   plans/{planId}             name, priceMonthlyEtb, maxBarbers, features,
//                              active   (public read, admin write)
//   payments/{paymentId}       written by functions only; read by the payer,
//                              the shop owner and admins
//   subscriptionPayments/{method}_{transactionId}
//                              an owner's transfer receipt (one doc per
//                              transaction platform-wide): shopId, ownerId,
//                              method ('telebirr'|'cbe'|'other'),
//                              transactionId, amount (ETB), status
//                              ('pending'|'needs_review'|'verified'|
//                              'rejected'), durationDays, createdAt,
//                              receiptImage? (base64 JPEG, <= 350000 chars)
//                              or imagePath? (Storage, Blaze),
//                              payerAccountSuffix? (cbe, 4..8 digits); set by
//                              an admin (or functions): verifiedBy,
//                              verifiedAmount, decisionReason, decidedAt
//   platformConfig/subscriptionPricing
//                              currency, tiers [{days, amount}], receivers,
//                              receiptUrls, updatedAt, updatedBy (admin
//                              writes; owners and admins read)
//   notificationLog/{id}       functions only (no client access)
//   emailCodes/{purpose}_{sha256(email)}
//                              functions/auth only (no client access):
//                              salted SHA-256 hash of a 6-digit email code
//                              for 'register' or 'reset', expiresAt,
//                              attempts, lastSentAt
//   authRateLimits/{key}       functions/auth only (no client access):
//                              per-email / per-IP send counters
//   inviteEmails/{email}_{createdAt}
//                              functions/auth only (no client access):
//                              marks an invite whose email was sent
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Paths
    // -----------------------------------------------------------------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/barbershops/$(shopId);
    }

    function barberPath(shopId, barberId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId);
    }

    function servicePath(shopId, serviceId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/services/$(serviceId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function slotLockPath(shopId, barberId, lockId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId)/slotLocks/$(lockId);
    }

    function timeOffPath(shopId, barberId, timeOffId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId)/timeOff/$(timeOffId);
    }

    function receiptPath(paymentId) {
      return /databases/$(database)/documents/subscriptionPayments/$(paymentId);
    }

    function barberContactPath(shopId, barberId) {
      return /databases/$(database)/documents/barbershops/$(shopId)/barbers/$(barberId)/private/contact;
    }

    function shopDeletionPath(shopId) {
      return /databases/$(database)/documents/shopDeletions/$(shopId);
    }

    // -----------------------------------------------------------------
    // Identity and roles (read from the caller's own users/{uid} doc)
    // -----------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // The caller's verified sign-in email (Google), lowercased, or '' if
    // the token has no email or it is not verified.
    function myEmail() {
      return request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    // The token email lowercased, verified or not ('' without one).
    function tokenEmail() {
      return request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    // Barber accounts: a shop owner creates a barber's email/password login
    // (unverified email) and writes its uid to invites/{email}.authUid. The
    // invite a caller may use is the one at their verified email or, for an
    // unverified login, at their token email - and then only an invite
    // naming their uid (matchesInvite).
    function inviteEmail() {
      return myEmail() != '' ? myEmail() : tokenEmail();
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isRole(role) {
      return hasProfile() && me().role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    // Owner of this shop (ownership comes from the owner's profile).
    function isOwnerOf(shopId) {
      return isRole('barbershopOwner') && me().get('shopId', '') == shopId;
    }

    function canManageShop(shopId) {
      return isAdmin() || isOwnerOf(shopId);
    }

    // The shop's owner or one of its barbers.
    function isStaffOf(shopId) {
      return hasProfile() &&
        me().role in ['barbershopOwner', 'barber'] &&
        me().get('shopId', '') == shopId;
    }

    // Signed-in barber linked to this barber profile. Deleting the barber
    // profile revokes the access.
    function isBarberProfile(shopId, barberId) {
      return isRole('barber') &&
        me().get('shopId', '') == shopId &&
        me().get('barberId', '') == barberId &&
        exists(barberPath(shopId, barberId));
    }

    // -----------------------------------------------------------------
    // Generic validators
    // -----------------------------------------------------------------

    function isEthiopianPhone(phone) {
      return phone is string && phone.matches('^[+]251[79][0-9]{8}$');
    }

    // A lowercased email address (invite ids and profile emails).
    function isValidEmail(email) {
      return email is string &&
        email.size() >= 3 && email.size() <= 254 &&
        email.matches('^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$');
    }

    // A business contact number: a mobile (+2519..., +2517...) or a fixed
    // line (+2511... to +2515..., e.g. Addis Ababa +25111...).
    function isEthiopianContactPhone(phone) {
      return phone is string && phone.matches('^[+]251[1-579][0-9]{8}$');
    }

    // Longest service (and so booking) in minutes. A booking writes one
    // slot lock per 15-minute block in its transaction (8 at most), and
    // every lock's rule reads the booking: this keeps the transaction well
    // inside the per-request limits on document reads (20) and expressions.
    // Same value as kMaxServiceDurationMinutes in availability_service.dart.
    function maxServiceMinutes() {
      return 120;
    }

    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Valid if missing, null, or a string within bounds.
    function optString(data, field, minLen, maxLen) {
      return !(field in data) || data[field] == null || isString(data[field], minLen, maxLen);
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 500 && url.matches('^https?://.+');
    }

    function optUrl(data, field) {
      return !(field in data) || data[field] == null || isValidUrl(data[field]);
    }

    // At most 50 characters (19 + 31). A regex alone is the cheapest type
    // check: matches() fails on anything but a string.
    function isValidDateString(value) {
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.{0,31}$');
    }

    function isValidDateOrTimestamp(value) {
      return value is timestamp || isValidDateString(value);
    }

    function optDate(data, field) {
      return !(field in data) || isValidDateOrTimestamp(data[field]);
    }

    function optInt(data, field, minValue, maxValue) {
      return !(field in data) ||
        (data[field] is int && data[field] >= minValue && data[field] <= maxValue);
    }

    function optWorkingDays(data) {
      return !('workingDays' in data) ||
        (data.workingDays is list && data.workingDays.size() <= 7 &&
          data.workingDays.hasOnly([1, 2, 3, 4, 5, 6, 7]));
    }

    // True if `field` has the same value before and after the write.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // -----------------------------------------------------------------
    // Time helpers (appointment instants and slot-lock ids)
    // -----------------------------------------------------------------

    // A whole-minute UTC instant exactly as Dart's
    // DateTime.toUtc().toIso8601String() writes it.
    function isUtcMinute(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[.]000Z$');
    }

    // ...on the 15-minute grid (Addis is a whole-hour offset from UTC).
    function isQuarterHour(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:(00|15|30|45):00[.]000Z$');
    }

    // Parses an isUtcMinute string.
    function utcMinuteToTs(s) {
      return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])) +
        duration.time(int(s[11:13]), int(s[14:16]), 0, 0);
    }

    // Slot-lock ids are the Addis wall clock (UTC+3) of the block start,
    // yyyyMMdd-HHmm, on the 15-minute grid. The helpers below avoid
    // ternary padding and timestamp parsing where they can: a 90-minute
    // booking writes seven documents, and all their rules share one budget
    // of 1000 evaluated expressions per request.

    // 'HHmm' of a minute of the day (zero-padded by formatting 1HHmm).
    function hhmm(minuteOfDay) {
      return string(10000 + int((minuteOfDay - minuteOfDay % 60) / 60) * 100 + minuteOfDay % 60)[1:5];
    }

    // The slot-lock id of the block starting at the UTC instant `s`
    // (an isQuarterHour string). Before 21:00 UTC the Addis day is the
    // UTC day, so the id is cut from the string; later blocks (Addis
    // 00:00-02:59) go through timestamp arithmetic.
    function lockIdOf(s) {
      return int(s[11:13]) < 21
        ? s[0:4] + s[5:7] + s[8:10] + '-' + string(103 + int(s[11:13]))[1:3] + s[14:16]
        : addisDayOf(utcMinuteToTs(s) + duration.value(3, 'h')) + '-' +
          hhmm((int(s[11:13]) - 21) * 60 + int(s[14:16]));
    }

    // 'yyyyMMdd' of a timestamp already shifted to Addis time.
    function addisDayOf(a) {
      return string(a.year() * 10000 + a.month() * 100 + a.day());
    }

    // The slot-lock id of the block starting at the UTC timestamp `t`.
    function lockIdOfTs(t) {
      let a = t + duration.value(3, 'h');
      return addisDayOf(a) + '-' + hhmm(a.hours() * 60 + a.minutes());
    }

    // A UTC instant as Dart's DateTime.toUtc().toIso8601String() writes it
    // (seconds, optional 1..6 fraction digits, 'Z').
    function isIsoInstant(s) {
      return s is string &&
        s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$');
    }

    // Parses an isIsoInstant string (to the second).
    function isoToTs(s) {
      return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])) +
        duration.time(int(s[11:13]), int(s[14:16]), int(s[17:19]), 0);
    }

    // A stored instant (ISO string or legacy timestamp) as a timestamp.
    function instantOf(v) {
      return v is timestamp ? v : utcMinuteToTs(v);
    }

    // -----------------------------------------------------------------
    // Shop booking policy (owner-editable; missing or out-of-range values
    // read as the defaults, like Barbershop.fromMap)
    // -----------------------------------------------------------------

    function policyInt(v, maxValue, def) {
      return (v is int && v >= 0 && v <= maxValue) ? v : def;
    }

    function cutoffHoursOf(shop) {
      return policyInt(shop.get('cancellationCutoffHours', 2), 72, 2);
    }

    function maxReschedulesOf(shop) {
      return policyInt(shop.get('maxReschedules', 2), 5, 2);
    }

    // A booking's shop document (empty map if the shop no longer exists).
    function shopDataOf(shopId) {
      return exists(shopPath(shopId)) ? get(shopPath(shopId)).data : {};
    }

    // The customer may still change the booking `b`: now is at least the
    // shop's cutoff before the start (equality allowed). Legacy bookings
    // without startAt have no cutoff.
    function beforeCutoff(b) {
      return !('startAt' in b) ||
        request.time <= instantOf(b.startAt) - duration.value(cutoffHoursOf(shopDataOf(b.shopId)), 'h');
    }

    // -----------------------------------------------------------------
    // Domain validators
    // -----------------------------------------------------------------

    // disabled, disabledAt, disabledBy, disabledReason: set (and removed)
    // by an admin only; see the users match.
    function disabledKeys() {
      return ['disabled', 'disabledAt', 'disabledBy', 'disabledReason'];
    }

    function isValidUser(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'phone', 'role', 'shopId', 'barberId', 'createdAt', 'language', 'mustChangePassword',
          'disabled', 'disabledAt', 'disabledBy', 'disabledReason']) &&
        d.keys().hasAll(['uid', 'email', 'name', 'phone', 'role', 'createdAt']) &&
        isString(d.uid, 1, 128) &&
        isValidEmail(d.email) &&
        isString(d.name, 1, 100) &&
        isEthiopianPhone(d.phone) &&
        d.role in ['customer', 'barber', 'barbershopOwner', 'admin'] &&
        optString(d, 'shopId', 1, 128) &&
        optString(d, 'barberId', 1, 128) &&
        (!('language' in d) || d.language in ['en', 'am']) &&
        (!('mustChangePassword' in d) || d.mustChangePassword is bool) &&
        (!('disabled' in d) || d.disabled is bool) &&
        optString(d, 'disabledAt', 20, 40) &&
        optString(d, 'disabledBy', 1, 128) &&
        optString(d, 'disabledReason', 1, 300) &&
        isValidDateOrTimestamp(d.createdAt) &&
        // Each role carries exactly the links it needs.
        (
          (d.role in ['customer', 'admin'] &&
            d.get('shopId', null) == null && d.get('barberId', null) == null) ||
          (d.role == 'barbershopOwner' &&
            d.get('shopId', null) is string && d.get('barberId', null) == null) ||
          (d.role == 'barber' &&
            d.get('shopId', null) is string && d.get('barberId', null) is string)
        );
    }

    // The role fields in `d` match the invite at `email` (the caller's
    // inviteEmail()), which the caller may use (`verified` email, or an
    // owner-created login named in authUid), and the same batch deletes
    // that invite (so it can only be used once). Fails without an invite.
    function matchesInvite(d, email, verified) {
      let inv = get(invitePath(email)).data;
      return (verified || inv.get('authUid', null) == request.auth.uid) &&
        inv.role == d.role &&
        inv.get('shopId', null) == d.get('shopId', null) &&
        inv.get('barberId', null) == d.get('barberId', null) &&
        !existsAfter(invitePath(email));
    }

    function matchesMyInvite(d) {
      let verified = myEmail();
      return matchesInvite(d, verified != '' ? verified : tokenEmail(), verified != '');
    }

    // A first profile (users/{uid} create, the caller's own uid): the
    // verified sign-in email and role `customer`, or what the caller's
    // invite says (an owner-created barber login: its token email and the
    // invite's mustChangePassword). Never the admin's disabled fields.
    function isValidNewProfile(d) {
      let verified = myEmail();
      let email = verified != '' ? verified : tokenEmail();
      return isValidUser(d) &&
        !d.keys().hasAny(disabledKeys()) &&
        d.uid == request.auth.uid &&
        email != '' &&
        d.email == email &&
        (
          (verified != '' && d.role == 'customer' && d.get('mustChangePassword', false) == false) ||
          (matchesInvite(d, email, verified != '') &&
            d.get('mustChangePassword', false) == get(invitePath(email)).data.get('mustChangePassword', false))
        );
    }

    // Invite ids are the invitee's lowercased email, repeated in `email`.
    // authUid (the login an owner created for a barber) only on barber
    // invites; mustChangePassword only together with authUid.
    function isValidInvite(d, email) {
      return d.keys().hasOnly(['email', 'role', 'name', 'shopId', 'barberId', 'createdBy', 'createdAt', 'authUid', 'mustChangePassword']) &&
        d.keys().hasAll(['email', 'role', 'name', 'createdBy', 'createdAt']) &&
        d.email == email &&
        isValidEmail(email) &&
        isString(d.name, 1, 100) &&
        d.createdBy == request.auth.uid &&
        isValidDateOrTimestamp(d.createdAt) &&
        optString(d, 'shopId', 1, 128) &&
        optString(d, 'barberId', 1, 128) &&
        (!('authUid' in d) || (d.role == 'barber' && isString(d.authUid, 1, 128))) &&
        (!('mustChangePassword' in d) || (d.mustChangePassword is bool && 'authUid' in d)) &&
        (
          (d.role == 'admin' &&
            d.get('shopId', null) == null && d.get('barberId', null) == null) ||
          (d.role == 'barbershopOwner' &&
            d.get('shopId', null) is string && d.get('barberId', null) == null &&
            existsAfter(shopPath(d.shopId))) ||
          (d.role == 'barber' &&
            d.get('shopId', null) is string && d.get('barberId', null) is string &&
            existsAfter(barberPath(d.shopId, d.barberId)))
        );
    }

    function isValidBarbershop(d) {
      return d.keys().hasOnly([
          'ownerId', 'name', 'description', 'address', 'city', 'subCity',
          'landmark', 'phone', 'imageUrl', 'rating', 'reviewCount',
          'openingHour', 'closingHour', 'workingDays', 'isVerified',
          'subscriptionPlan', 'subscriptionStatus', 'subscriptionEndsAt',
          'createdAt', 'cancellationCutoffHours', 'maxReschedules',
          'requireBarberAcceptance',
          // Admin only (adminSuspensionOk, receiptLinkOk).
          'adminSuspended', 'adminSuspendedReason', 'adminSuspendedAt',
          'adminSuspendedBy', 'subscriptionReceiptId',
          // Client-side subscription expiry (isSubscriptionLapse).
          'subscriptionStatusChangedAt'
        ]) &&
        (!('subscriptionStatusChangedAt' in d) || isIsoInstant(d.subscriptionStatusChangedAt)) &&
        optInt(d, 'cancellationCutoffHours', 0, 72) &&
        optInt(d, 'maxReschedules', 0, 5) &&
        (!('requireBarberAcceptance' in d) || d.requireBarberAcceptance is bool) &&
        (!('adminSuspended' in d) || d.adminSuspended is bool) &&
        optString(d, 'subscriptionReceiptId', 1, 200) &&
        d.keys().hasAll(['ownerId', 'name', 'description', 'address', 'city', 'phone', 'imageUrl']) &&
        isString(d.ownerId, 0, 128) &&
        isString(d.name, 1, 120) &&
        // May be empty: a shop approved from an application without one.
        isString(d.description, 0, 1000) &&
        isString(d.address, 1, 200) &&
        isString(d.city, 1, 100) &&
        (!('subCity' in d) || isString(d.subCity, 0, 60)) &&
        optString(d, 'landmark', 0, 200) &&
        isEthiopianContactPhone(d.phone) &&
        isValidUrl(d.imageUrl) &&
        (!('rating' in d) || (d.rating is number && d.rating >= 0 && d.rating <= 5)) &&
        optInt(d, 'reviewCount', 0, 100000000) &&
        optInt(d, 'ratingSum', 0, 500000000) &&
        optString(d, 'lastReviewId', 1, 128) &&
        optInt(d, 'openingHour', 0, 23) &&
        optInt(d, 'closingHour', 1, 24) &&
        optWorkingDays(d) &&
        (!('isVerified' in d) || d.isVerified is bool) &&
        (!('subscriptionPlan' in d) || d.subscriptionPlan in ['trial', 'basic', 'pro']) &&
        (!('subscriptionStatus' in d) ||
          d.subscriptionStatus in ['trialing', 'active', 'past_due', 'suspended']) &&
        optDate(d, 'subscriptionEndsAt') &&
        optDate(d, 'createdAt');
    }

    // Shop updates (see the barbershops match): the keys each role may
    // change, and per group of fields a check that runs only when one of
    // them changes (the stored values were checked when written). One
    // shop update evaluates a fraction of isValidBarbershop.

    // Profile: owner or admin. ownerId is checked by the caller's branch.
    function shopProfileOk(d, ck) {
      return !ck.hasAny(['ownerId', 'name', 'description', 'address', 'city', 'subCity', 'landmark', 'phone', 'imageUrl']) || (
        isString(d.ownerId, 0, 128) &&
        d.name.matches('(?s)^.{1,120}$') &&
        // May be empty: a shop approved from an application without one.
        d.description.matches('(?s)^.{0,1000}$') &&
        d.address.matches('(?s)^.{1,200}$') &&
        d.city.matches('(?s)^.{1,100}$') &&
        (!('subCity' in d) || d.subCity.matches('(?s)^.{0,60}$')) &&
        optString(d, 'landmark', 0, 200) &&
        isEthiopianContactPhone(d.phone) &&
        isValidUrl(d.imageUrl));
    }

    // Opening hours (owner only) and booking policy (owner or admin).
    function shopHoursPolicyOk(d, ck) {
      return !ck.hasAny(['openingHour', 'closingHour', 'workingDays', 'cancellationCutoffHours',
          'maxReschedules', 'requireBarberAcceptance']) || (
        optInt(d, 'openingHour', 0, 23) &&
        optInt(d, 'closingHour', 1, 24) &&
        optWorkingDays(d) &&
        optInt(d, 'cancellationCutoffHours', 0, 72) &&
        optInt(d, 'maxReschedules', 0, 5) &&
        (!('requireBarberAcceptance' in d) || d.requireBarberAcceptance is bool));
    }

    // Verification and subscription (admin only; the admin suspension is
    // adminSuspensionOk, the receipt link receiptLinkOk).
    function shopPlatformOk(d, ck) {
      return !ck.hasAny(['isVerified', 'subscriptionPlan', 'subscriptionStatus', 'subscriptionEndsAt',
          'createdAt', 'subscriptionStatusChangedAt', 'subscriptionReceiptId']) || (
        (!('isVerified' in d) || d.isVerified is bool) &&
        (!('subscriptionPlan' in d) || d.subscriptionPlan in ['trial', 'basic', 'pro']) &&
        (!('subscriptionStatus' in d) ||
          d.subscriptionStatus in ['trialing', 'active', 'past_due', 'suspended']) &&
        optDate(d, 'subscriptionEndsAt') &&
        optDate(d, 'createdAt') &&
        (!('subscriptionStatusChangedAt' in d) || isIsoInstant(d.subscriptionStatusChangedAt)) &&
        optString(d, 'subscriptionReceiptId', 1, 200));
    }

    // The admin edits the profile, verification, subscription and booking
    // policy (admin_shop_edit_screen), suspends / reactivates the shop
    // (adminSuspensionOk), links an approved receipt (receiptLinkOk) and
    // sets ownerId (role changes). Never the rating (functions/insights)
    // or the opening hours (the owner's).
    function isAdminShopUpdate(shopId) {
      let d = request.resource.data;
      let ck = d.diff(resource.data).affectedKeys();
      return ck.hasOnly([
          'ownerId', 'name', 'description', 'address', 'city', 'subCity', 'landmark', 'phone',
          'imageUrl', 'isVerified', 'subscriptionPlan', 'subscriptionStatus', 'subscriptionEndsAt',
          'createdAt', 'cancellationCutoffHours', 'maxReschedules', 'requireBarberAcceptance',
          'adminSuspended', 'adminSuspendedReason', 'adminSuspendedAt', 'adminSuspendedBy',
          'subscriptionReceiptId', 'subscriptionStatusChangedAt'
        ]) &&
        shopProfileOk(d, ck) &&
        shopHoursPolicyOk(d, ck) &&
        shopPlatformOk(d, ck) &&
        adminSuspensionOk(ck) &&
        receiptLinkOk(shopId, ck);
    }

    // The owner edits the profile, opening hours and booking policy, and
    // may claim an unowned shop (ownerId '') once.
    function isOwnerShopUpdate() {
      let d = request.resource.data;
      let ck = d.diff(resource.data).affectedKeys();
      return ck.hasOnly([
          'ownerId', 'name', 'description', 'address', 'city', 'subCity', 'landmark', 'phone',
          'imageUrl', 'openingHour', 'closingHour', 'workingDays', 'cancellationCutoffHours',
          'maxReschedules', 'requireBarberAcceptance'
        ]) &&
        (!ck.hasAny(['ownerId']) || (resource.data.ownerId == '' && d.ownerId == request.auth.uid)) &&
        shopProfileOk(d, ck) &&
        shopHoursPolicyOk(d, ck);
    }

    // Free (Spark) plan: no daily payments function, so the owner's app
    // persists a lapsed period itself (subscription_state.dart,
    // subscriptionTransitionPatch). Exactly {subscriptionStatus,
    // subscriptionStatusChangedAt (ISO, client clock)}, downgrades only,
    // and only once the stored end date says so (same as statusForEnd in
    // functions/payments): trialing/active -> past_due from the end;
    // trialing/active/past_due -> suspended from 7 days (GRACE_DAYS) after.
    // Its own `allow update` (before the general one), without
    // isValidBarbershop: the shop update rule is close to the budget of
    // 1000 evaluated expressions, and only these two fields change, both
    // checked here. Each instant is parsed once (function arguments).
    function isSubscriptionLapse() {
      let d = request.resource.data;
      let end = resource.data.get('subscriptionEndsAt', null);
      return changedKeys().hasOnly(['subscriptionStatus', 'subscriptionStatusChangedAt']) &&
        (end is timestamp || isIsoInstant(end)) &&
        isIsoInstant(d.get('subscriptionStatusChangedAt', null)) &&
        isNearNow(isoToTs(d.subscriptionStatusChangedAt)) &&
        lapseAllowed(resource.data.get('subscriptionStatus', 'trialing'), d.get('subscriptionStatus', null),
          subscriptionEndOf(end));
    }

    // A client-clock instant within a day before / an hour after now.
    function isNearNow(t) {
      return t <= request.time + duration.value(1, 'h') &&
        t >= request.time - duration.value(1, 'd');
    }

    // `from` -> `to` is due at `end` (the stored period end).
    function lapseAllowed(from, to, end) {
      return (from in ['trialing', 'active'] && to == 'past_due' && request.time >= end) ||
        (from in ['trialing', 'active', 'past_due'] && to == 'suspended' &&
          request.time >= end + duration.value(7, 'd'));
    }

    // Admin suspension (separate from the subscription status). Suspend:
    // {adminSuspended: true, adminSuspendedReason (1..300, not blank),
    // adminSuspendedAt (ISO), adminSuspendedBy: the admin's uid}.
    // Reactivate: {adminSuspended: false} with the other three deleted.
    function adminSuspensionOk(ck) {
      let d = request.resource.data;
      return !ck.hasAny(['adminSuspended', 'adminSuspendedReason', 'adminSuspendedAt', 'adminSuspendedBy']) ||
        (d.get('adminSuspended', null) == true &&
          d.get('adminSuspendedReason', null) is string &&
          d.adminSuspendedReason.trim().size() >= 1 &&
          d.adminSuspendedReason.size() <= 300 &&
          isIsoInstant(d.get('adminSuspendedAt', null)) &&
          d.get('adminSuspendedBy', null) == request.auth.uid) ||
        (d.get('adminSuspended', null) == false &&
          !d.keys().hasAny(['adminSuspendedReason', 'adminSuspendedAt', 'adminSuspendedBy']));
    }

    // subscriptionReceiptId changes only in the batch that approves that
    // receipt: it was open before this write and is 'verified' for this
    // shop after it (the receipt rule checks the other direction).
    function receiptLinkOk(shopId, ck) {
      return !ck.hasAny(['subscriptionReceiptId']) ||
        receiptLinkedNow(shopId, request.resource.data.get('subscriptionReceiptId', null));
    }

    function receiptLinkedNow(shopId, id) {
      return (id is string &&
          get(receiptPath(id)).data.status in ['pending', 'needs_review'] &&
          getAfter(receiptPath(id)).data.status == 'verified' &&
          getAfter(receiptPath(id)).data.shopId == shopId);
    }

    // Customers see shops that are not suspended. This must be provable
    // from the customer listener's `subscriptionStatus in [...]` filter,
    // so it reads the field directly: docs without it (written before
    // subscriptions existed) are visible to their staff and admins only.
    function isCustomerVisibleShop(d) {
      return d.subscriptionStatus in ['trialing', 'active', 'past_due'];
    }

    function isValidService(d, shopId) {
      return d.keys().hasOnly(['shopId', 'name', 'description', 'price', 'durationMinutes']) &&
        d.keys().hasAll(['shopId', 'name', 'description', 'price', 'durationMinutes']) &&
        d.shopId == shopId &&
        isString(d.name, 1, 100) &&
        isString(d.description, 1, 500) &&
        d.price is number && d.price >= 0 && d.price <= 100000 &&
        d.durationMinutes is int && d.durationMinutes >= 5 && d.durationMinutes <= maxServiceMinutes();
    }

    function isValidBarber(d, shopId) {
      return d.keys().hasOnly([
          'shopId', 'name', 'title', 'avatarUrl', 'rating', 'reviewCount',
          'ratingSum', 'lastReviewId',
          'isAvailable', 'email', 'phone', 'specialties', 'workingDays',
          'startHour', 'endHour', 'commissionPercent'
        ]) &&
        d.keys().hasAll(['shopId', 'name', 'title']) &&
        d.shopId == shopId &&
        isString(d.name, 1, 100) &&
        isString(d.title, 1, 100) &&
        optUrl(d, 'avatarUrl') &&
        optString(d, 'email', 3, 254) &&
        optString(d, 'phone', 1, 30) &&
        (!('rating' in d) || (d.rating is number && d.rating >= 0 && d.rating <= 5)) &&
        optInt(d, 'reviewCount', 0, 100000000) &&
        optInt(d, 'ratingSum', 0, 500000000) &&
        optString(d, 'lastReviewId', 1, 128) &&
        (!('isAvailable' in d) || d.isAvailable is bool) &&
        (!('specialties' in d) || (d.specialties is list && d.specialties.size() <= 20)) &&
        optWorkingDays(d) &&
        optInt(d, 'startHour', 0, 23) &&
        optInt(d, 'endHour', 1, 24) &&
        optInt(d, 'commissionPercent', 0, 100);
    }

    // The booking's slot locks, created in the same transaction. `pre` is
    // the lock path up to the Addis day ('.../slotLocks/yyyyMMdd-'), `dur`
    // the duration and `m0` the start's Addis minute of the day (on the
    // 15-minute grid). The first four blocks and the last block are
    // checked (rules have per-request budgets for document reads and
    // expressions); the verifyBookingLocks function (functions/bookings)
    // checks every block after the write and cancels the booking if one is
    // missing.
    // Lock ids without hhmm(): `hm` is 1HHmm of the start (an int), so
    // block k (k = 1..3) is hm + 15k, plus 40 when it passes the hour
    // (+100 - 60). Bookings end by Addis midnight, so no day rolls over.
    function holdsLocks(bookingId, pre, dur, m0) {
      let q = m0 % 60;
      let hm = 10000 + m0 / 60 * 100 + q;
      let last = m0 + (dur - 1) - (dur - 1) % 15;
      return getAfter(path(pre + string(hm)[1:5])).data.bookingId == bookingId &&
        (dur <= 15 || getAfter(path(pre + string(q >= 45 ? hm + 55 : hm + 15)[1:5])).data.bookingId == bookingId) &&
        (dur <= 30 || getAfter(path(pre + string(q >= 30 ? hm + 70 : hm + 30)[1:5])).data.bookingId == bookingId) &&
        (dur <= 45 || getAfter(path(pre + string(q >= 15 ? hm + 85 : hm + 45)[1:5])).data.bookingId == bookingId) &&
        (dur <= 60 || getAfter(path(pre + string(10000 + last / 60 * 100 + last % 60)[1:5])).data.bookingId == bookingId);
    }

    // The appointment interval: endAt = startAt + durationMinutes, starting
    // in the next 31 days and ending by Addis midnight; and its slot locks
    // are held.
    function isValidInterval(d, bookingId) {
      let start = utcMinuteToTs(d.startAt);
      let a = start + duration.value(3, 'h');
      let m0 = a.hours() * 60 + a.minutes();
      return utcMinuteToTs(d.endAt) == start + duration.value(d.durationMinutes, 'm') &&
        start > request.time &&
        start < request.time + duration.value(31, 'd') &&
        m0 + d.durationMinutes <= 1440 &&
        holdsLocks(bookingId,
          '/databases/' + database + '/documents/barbershops/' + d.shopId + '/barbers/' + d.barberId +
            '/slotLocks/' + addisDayOf(a) + '-',
          d.durationMinutes, m0);
    }

    // A new booking from the app.
    function isValidNewBooking(d, bookingId) {
      // Exactly these keys.
      return d.keys().toSet() == [
          'shopId', 'shopName', 'barberId', 'barberName', 'customerId',
          'customerName', 'customerPhone', 'serviceId', 'serviceName',
          'price', 'date', 'timeSlot', 'status', 'createdAt',
          'startAt', 'endAt', 'durationMinutes', 'paymentStatus',
          'paymentMethod'
        ].toSet() &&
        // Strings of at most N characters ((?s): newlines count too); a
        // regex is cheaper than `is string && size() <= N`.
        d.shopName.matches('(?s)^.{0,120}$') &&
        d.barberName.matches('(?s)^.{0,100}$') &&
        d.customerName.matches('(?s)^.{0,100}$') &&
        d.customerPhone.matches('(?s)^.{0,30}$') &&
        d.serviceName.matches('(?s)^.{0,100}$') &&
        d.timeSlot.matches('(?s)^.{0,50}$') &&
        isValidDateString(d.date) &&
        isValidDateString(d.createdAt) &&
        // status: 'pending' or 'confirmed', checked by isBookable.
        d.paymentStatus == 'unpaid' &&
        d.paymentMethod in ['cash', 'chapa'] &&
        d.durationMinutes is int &&
        d.durationMinutes <= maxServiceMinutes() &&
        isQuarterHour(d.startAt) &&
        isUtcMinute(d.endAt) &&
        isValidInterval(d, bookingId);
    }

    // A booking may only reference a bookable shop, an available barber
    // and a real service, at that service's price and duration.
    //
    // Document reads of a booking create, worst case: the caller's profile,
    // five slot locks, shop, barber and service = 9 (limit 10 per document
    // write, 20 per transaction; each of the at most 8 lock writes reads
    // the booking once more: 17 even if nothing is shared).
    //
    // Barber acceptance: the booking starts 'pending' exactly when the shop
    // has requireBarberAcceptance == true, else 'confirmed'.
    //
    // An admin-suspended shop (adminSuspended == true) takes no bookings,
    // nor does one 7 days or more past its subscriptionEndsAt whose stored
    // status still lags (inGracePeriod; free plan, no daily function).
    // Its slot locks need no check of their own: they are only valid with
    // a live booking of the caller (canCreateSlotLock), created or moved
    // in the same transaction under this rule or isValidReschedule.
    function isBookable(d) {
      let svc = get(servicePath(d.shopId, d.serviceId)).data;
      let shop = get(shopPath(d.shopId)).data;
      return shop.get('subscriptionStatus', 'trialing') != 'suspended' &&
        shop.get('adminSuspended', false) != true &&
        inGracePeriod(shop) &&
        d.status == (shop.get('requireBarberAcceptance', false) == true ? 'pending' : 'confirmed') &&
        get(barberPath(d.shopId, d.barberId)).data.get('isAvailable', true) == true &&
        svc.price == d.price &&
        svc.durationMinutes == d.durationMinutes;
    }

    // A lock for a block inside a live booking of the caller's, at this
    // shop and barber. The booking may be created in the same transaction.
    // The lock is bound to its booking through getAfter(booking) and holds
    // no customer data (any signed-in user can read locks). expiresAt is
    // the booking's end plus one day, for the cleanup job.
    // Kept lean: a 120-minute booking writes eight locks, and every write
    // of the transaction shares one budget of evaluated expressions.
    // (Reading bookingId, startAt and expiresAt fails if one is missing,
    // so hasOnly is enough for the shape.)
    function canCreateSlotLock(shopId, barberId, lockId, d) {
      let bk = getAfter(bookingPath(d.bookingId)).data;
      return d.keys().hasOnly(['bookingId', 'startAt', 'expiresAt']) &&
        bk.customerId == request.auth.uid &&
        bk.shopId == shopId &&
        bk.barberId == barberId &&
        bk.status in ['pending', 'confirmed'] &&
        isQuarterHour(d.startAt) &&
        d.startAt >= bk.startAt &&
        d.startAt < bk.endAt &&
        lockId == lockIdOf(d.startAt) &&
        isUtcMinute(d.expiresAt) &&
        utcMinuteToTs(d.expiresAt) == utcMinuteToTs(bk.endAt) + duration.value(1, 'd');
    }

    // Releasing a booking lock: its booking is cancelled (now or earlier)
    // and the caller is someone who may cancel that booking; or the
    // booking's customer released a block the booking no longer covers
    // (a reschedule: the lock's block is outside the booking's interval
    // after this write, and the booking is still live).
    function canReleaseSlotLock(shopId, barberId) {
      let bk = getAfter(bookingPath(resource.data.bookingId)).data;
      return bk.shopId == shopId &&
        bk.barberId == barberId &&
        (
          (bk.status == 'cancelled' &&
            (bk.customerId == request.auth.uid || isBarberProfile(shopId, barberId))) ||
          (bk.customerId == request.auth.uid &&
            bk.status in ['pending', 'confirmed'] &&
            (resource.data.startAt < bk.startAt || resource.data.startAt >= bk.endAt))
        );
    }

    // A time-off lock: the block lies inside the time-off range of the
    // same barber, written in the same batch (bound through getAfter), by
    // the owner or that barber. Up to 96 of these share one request, so
    // the cheap shape checks come first.
    function canCreateTimeOffLock(shopId, barberId, lockId, d) {
      let t = getAfter(timeOffPath(shopId, barberId, d.timeOffId)).data;
      return d.keys().hasOnly(['timeOffId', 'startAt', 'expiresAt']) &&
        isQuarterHour(d.startAt) &&
        d.startAt >= t.startAt &&
        d.startAt < t.endAt &&
        isUtcMinute(d.expiresAt) &&
        utcMinuteToTs(d.expiresAt) == utcMinuteToTs(t.endAt) + duration.value(1, 'd') &&
        lockId == lockIdOf(d.startAt) &&
        canManageTimeOff(shopId, barberId);
    }

    // The owner of the shop or that barber (admins do not manage time off).
    function canManageTimeOff(shopId, barberId) {
      return isOwnerOf(shopId) || isBarberProfile(shopId, barberId);
    }

    // The time-off lock of the block starting at timestamp `t` exists after
    // this write and belongs to `timeOffId`.
    function holdsTimeOffLock(shopId, barberId, timeOffId, t) {
      return getAfter(slotLockPath(shopId, barberId, lockIdOfTs(t))).data.get('timeOffId', '') == timeOffId;
    }

    // The time-off lock of the block at `t` is gone (or was reused) after
    // this write.
    function releasedTimeOffLock(shopId, barberId, timeOffId, t) {
      let p = slotLockPath(shopId, barberId, lockIdOfTs(t));
      return !existsAfter(p) || getAfter(p).data.get('timeOffId', '') != timeOffId;
    }

    // A new time-off range: quarter hours, end after start, within one
    // Addis day (end at most the next Addis midnight), not over yet, and
    // its first and last blocks locked in the same batch (the locks rule
    // checks each lock against this document).
    function isValidNewTimeOff(shopId, barberId, timeOffId, d) {
      let s = utcMinuteToTs(d.startAt);
      let e = utcMinuteToTs(d.endAt);
      let a = s + duration.value(3, 'h');
      let m0 = a.hours() * 60 + a.minutes();
      return d.keys().hasOnly(['startAt', 'endAt', 'reason', 'createdBy', 'createdAt', 'groupId', 'groupFrom', 'groupTo']) &&
        d.keys().hasAll(['startAt', 'endAt', 'createdBy', 'createdAt']) &&
        timeOffId.size() <= 128 &&
        // A vacation (several days) is saved as one time off per day, all
        // with groupId (1..128) and its Addis dates groupFrom <= groupTo
        // ('yyyy-MM-dd'); all three or none.
        (!d.keys().hasAny(['groupId', 'groupFrom', 'groupTo']) ||
          (isString(d.get('groupId', null), 1, 128) &&
            d.get('groupFrom', null).matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            d.get('groupTo', null).matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            d.groupFrom <= d.groupTo)) &&
        isQuarterHour(d.startAt) &&
        isQuarterHour(d.endAt) &&
        e > s &&
        e.toMillis() - s.toMillis() <= (1440 - m0) * 60000 &&
        e > request.time &&
        (!('reason' in d) || isString(d.reason, 1, 200)) &&
        d.createdBy == request.auth.uid &&
        isValidDateString(d.createdAt) &&
        holdsTimeOffLock(shopId, barberId, timeOffId, s) &&
        holdsTimeOffLock(shopId, barberId, timeOffId, e - duration.value(15, 'm'));
    }

    // A booking's status transition. noShow is set only from pending or
    // confirmed, once the appointment has started, and is final (only the
    // admin's payment correction may touch such a booking).
    function statusTransitionOk() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (from == 'noShow' && to == 'noShow') ||
        (from != 'noShow' && to != 'noShow') ||
        (from in ['pending', 'confirmed'] && to == 'noShow' &&
          'startAt' in resource.data &&
          request.time >= instantOf(resource.data.startAt));
    }

    // The customer moves their booking (same barber, service, duration and
    // price): exactly startAt, endAt, date, timeSlot, rescheduleCount (+1,
    // up to the shop's maxReschedules) and rescheduledAt change (checked
    // by the allow statement, before this), before the shop's cutoff for
    // the CURRENT start; the new interval is valid as on create and holds
    // its slot locks (checked through getAfter).
    function isValidReschedule(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      let shop = shopDataOf(r.shopId);
      return r.customerId == request.auth.uid &&
        r.status in ['pending', 'confirmed'] &&
        shop.get('adminSuspended', false) != true &&
        d.get('rescheduleCount', -1) is int &&
        d.rescheduleCount == r.get('rescheduleCount', 0) + 1 &&
        d.rescheduleCount <= maxReschedulesOf(shop) &&
        'startAt' in r &&
        request.time <= instantOf(r.startAt) - duration.value(cutoffHoursOf(shop), 'h') &&
        isValidDateString(d.date) &&
        isString(d.timeSlot, 1, 50) &&
        isValidDateString(d.get('rescheduledAt', null)) &&
        d.durationMinutes is int &&
        d.durationMinutes <= maxServiceMinutes() &&
        isQuarterHour(d.startAt) &&
        isUtcMinute(d.endAt) &&
        isValidInterval(d, bookingId);
    }

    // -----------------------------------------------------------------
    // Walk-in queue
    // -----------------------------------------------------------------

    // The shop's owner, or a barber of the shop whose profile still exists.
    function isQueueStaffOf(shopId) {
      return isOwnerOf(shopId) ||
        (isRole('barber') && me().get('shopId', '') == shopId &&
          exists(barberPath(shopId, me().get('barberId', ''))));
    }

    function isValidNewQueueEntry(shopId, d) {
      return d.keys().hasOnly(['name', 'phone', 'serviceId', 'barberId', 'status', 'createdAt', 'addedBy', 'source']) &&
        d.keys().hasAll(['name', 'status', 'createdAt', 'addedBy', 'source']) &&
        isString(d.name, 1, 60) &&
        (!('phone' in d) || isEthiopianPhone(d.phone)) &&
        (!('serviceId' in d) || (isString(d.serviceId, 1, 128) && exists(servicePath(shopId, d.serviceId)))) &&
        (!('barberId' in d) || (isString(d.barberId, 1, 128) && exists(barberPath(shopId, d.barberId)))) &&
        d.status == 'waiting' &&
        isValidDateString(d.createdAt) &&
        d.addedBy == request.auth.uid;
    }

    // queueSummary/current: {waitingCount (0..500), estimatedWaitMinutes
    // (0..100000), positions {entryId: {position, waitMinutes}} with one
    // entry per waiting customer, updatedAt (ISO)}. Rules cannot loop over
    // the positions map, so only its size is checked.
    function isValidQueueSummary(d) {
      return d.keys().hasOnly(['waitingCount', 'estimatedWaitMinutes', 'positions', 'updatedAt']) &&
        d.keys().hasAll(['waitingCount', 'estimatedWaitMinutes', 'positions', 'updatedAt']) &&
        d.waitingCount is int && d.waitingCount >= 0 && d.waitingCount <= 500 &&
        d.estimatedWaitMinutes is int && d.estimatedWaitMinutes >= 0 && d.estimatedWaitMinutes <= 100000 &&
        d.positions is map && d.positions.size() == d.waitingCount &&
        isIsoInstant(d.updatedAt);
    }

    // waiting -> left, or serving -> done: {status, finishedAt}.
    function isQueueFinish(from, to) {
      return changedKeys().hasOnly(['status', 'finishedAt']) &&
        resource.data.status == from &&
        request.resource.data.status == to &&
        isValidDateString(request.resource.data.get('finishedAt', null));
    }

    // waiting -> serving with a barber of the shop.
    function isQueueStartServing(shopId) {
      let d = request.resource.data;
      return changedKeys().hasOnly(['status', 'barberId', 'servingStartedAt']) &&
        resource.data.status == 'waiting' &&
        d.status == 'serving' &&
        d.get('barberId', null) is string &&
        exists(barberPath(shopId, d.barberId)) &&
        isValidDateString(d.get('servingStartedAt', null));
    }

    // -----------------------------------------------------------------
    // Reviews
    // -----------------------------------------------------------------

    // The barber's rating counters after this write: lastReviewId names
    // this review, reviewCount changed by `countDelta` and ratingSum by
    // `sumDelta` (a missing reviewCount is 0, a missing ratingSum the
    // legacy round(rating * reviewCount)). Exact maths, no clamping.
    function barberCountersAfter(barber, reviewId, sumDelta, countDelta) {
      let old = get(barber).data;
      let now = getAfter(barber).data;
      let oldCount = old.get('reviewCount', 0);
      return now.get('lastReviewId', '') == reviewId &&
        now.get('reviewCount', -1) == oldCount + countDelta &&
        now.get('ratingSum', -1) == old.get('ratingSum', math.round(old.get('rating', 0) * oldCount)) + sumDelta;
    }

    // One review per completed booking (doc id = bookingId), by its
    // customer, copying the booking's shop, barber and customer name. The
    // same write must add it to the barber's counters
    // (isReviewCounterUpdate: lastReviewId = reviewId, reviewCount + 1,
    // ratingSum + stars), unless the barber profile no longer exists.
    function isValidNewReview(shopId, reviewId, d) {
      let b = get(bookingPath(reviewId)).data;
      let barber = barberPath(shopId, d.barberId);
      return d.keys().hasOnly(['bookingId', 'shopId', 'barberId', 'customerId', 'customerName', 'rating', 'comment', 'createdAt']) &&
        d.keys().hasAll(['bookingId', 'shopId', 'barberId', 'customerId', 'customerName', 'rating', 'createdAt']) &&
        d.bookingId == reviewId &&
        d.shopId == shopId &&
        d.customerId == request.auth.uid &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        (!('comment' in d) || isString(d.comment, 1, 500)) &&
        isValidDateString(d.createdAt) &&
        b.customerId == request.auth.uid &&
        b.status == 'completed' &&
        b.shopId == shopId &&
        b.barberId == d.barberId &&
        b.customerName == d.customerName &&
        (!exists(barber) || barberCountersAfter(barber, reviewId, d.rating, 1));
    }

    // The customer edits their review (the allow statement checked the
    // caller and that only rating, comment and editedAt change): stars
    // 1..5, comment removed or 1..500, editedAt a new ISO instant. New
    // stars move the barber's ratingSum by the difference in the same
    // transaction (reviewCount unchanged).
    function isReviewEdit(shopId, reviewId) {
      let d = request.resource.data;
      let r = resource.data;
      let barber = barberPath(shopId, r.barberId);
      return d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        (!('comment' in d) || isString(d.comment, 1, 500)) &&
        isIsoInstant(d.get('editedAt', null)) &&
        d.editedAt != r.get('editedAt', '') &&
        (d.rating == r.rating || !exists(barber) ||
          barberCountersAfter(barber, reviewId, d.rating - r.rating, 0));
    }

    // The customer's barber-counter update written with a review change
    // (same transaction; the allow statement checked that only ratingSum,
    // reviewCount and lastReviewId change). lastReviewId names the
    // caller's own review of this barber that this write
    //  - creates: reviewCount + 1, ratingSum + its stars;
    //  - edits (its editedAt changes): ratingSum + new - old stars,
    //    reviewCount unchanged;
    //  - deletes: reviewCount - 1, ratingSum - its stars.
    // So each counter change needs its own review change (no replays; two
    // deletes in one write cannot both be lastReviewId). A missing
    // reviewCount is 0; a missing ratingSum is the legacy round(rating *
    // reviewCount). Exact maths, no clamping: a legacy-rounded barber may
    // go below 0 rather than block a customer's delete.
    function isReviewCounterUpdate(shopId, barberId) {
      let d = request.resource.data;
      let old = resource.data;
      let reviewId = d.get('lastReviewId', '');
      let review = /databases/$(database)/documents/barbershops/$(shopId)/reviews/$(reviewId);
      let oldCount = old.get('reviewCount', 0);
      let oldSum = old.get('ratingSum', math.round(old.get('rating', 0) * oldCount));
      return reviewId is string && reviewId.size() > 0 &&
        (
          // Create.
          (!exists(review) &&
            existsAfter(review) &&
            getAfter(review).data.customerId == request.auth.uid &&
            getAfter(review).data.barberId == barberId &&
            d.get('reviewCount', -1) == oldCount + 1 &&
            d.get('ratingSum', -1) == oldSum + getAfter(review).data.rating) ||
          // Edit.
          (exists(review) &&
            existsAfter(review) &&
            get(review).data.customerId == request.auth.uid &&
            get(review).data.barberId == barberId &&
            changedKeys().hasOnly(['ratingSum', 'lastReviewId']) &&
            getAfter(review).data.get('editedAt', '') != get(review).data.get('editedAt', '') &&
            d.get('ratingSum', -1) == oldSum + getAfter(review).data.rating - get(review).data.rating) ||
          // Delete.
          (exists(review) &&
            !existsAfter(review) &&
            get(review).data.customerId == request.auth.uid &&
            get(review).data.barberId == barberId &&
            d.get('reviewCount', -1) == oldCount - 1 &&
            d.get('ratingSum', -1) == oldSum - get(review).data.rating)
        );
    }

    function isValidPlan(d) {
      return d.keys().hasOnly(['name', 'priceMonthlyEtb', 'maxBarbers', 'features', 'active']) &&
        d.keys().hasAll(['name', 'priceMonthlyEtb', 'maxBarbers', 'features', 'active']) &&
        isString(d.name, 1, 60) &&
        d.priceMonthlyEtb is number && d.priceMonthlyEtb >= 0 && d.priceMonthlyEtb <= 1000000 &&
        d.maxBarbers is int && d.maxBarbers >= -1 && d.maxBarbers <= 1000 &&
        d.features is list && d.features.size() <= 30 &&
        d.active is bool;
    }

    function isValidDevice(d) {
      return d.keys().hasOnly(['token', 'platform', 'updatedAt']) &&
        d.keys().hasAll(['token', 'platform', 'updatedAt']) &&
        isString(d.token, 1, 4096) &&
        d.platform in ['android', 'ios', 'web'] &&
        isValidDateString(d.updatedAt);
    }

    // -----------------------------------------------------------------
    // Barber acceptance (booking requests)
    // -----------------------------------------------------------------

    // The booked barber, the shop's owner or an admin answers a request.
    function canAnswerRequest() {
      return isBarberProfile(resource.data.shopId, resource.data.barberId) ||
        isOwnerOf(resource.data.shopId) ||
        isAdmin();
    }

    // pending -> confirmed with exactly {status, acceptedAt}, before the
    // appointment starts. The slot locks stay.
    function isAcceptRequest() {
      let d = request.resource.data;
      return resource.data.status == 'pending' &&
        changedKeys().hasOnly(['status', 'acceptedAt']) &&
        d.status == 'confirmed' &&
        isValidDateString(d.get('acceptedAt', null)) &&
        (!('startAt' in resource.data) || request.time < instantOf(resource.data.startAt)) &&
        canAnswerRequest();
    }

    // -----------------------------------------------------------------
    // Booking updates. The bookings match has one `allow update` per kind
    // of update, each behind a cheap check of what changes (the rules of
    // one document may evaluate at most 1000 expressions).
    // -----------------------------------------------------------------

    // A refund flag: a cancel of a PAID booking adds it in the same update
    // (or the owner's sweep later, isRefundBookkeeping). Payment documents
    // stay functions-only.
    function refundFlagKeys() {
      return ['refundStatus', 'refundAmount', 'refundReason', 'refundFlaggedAt'];
    }

    // The four flag fields are valid: the booking is paid and has no
    // refund state yet; refundStatus 'due', 0 < refundAmount <= price, a
    // known reason, refundFlaggedAt an ISO instant.
    function refundFlagOk() {
      let d = request.resource.data;
      return resource.data.get('paymentStatus', '') == 'paid' &&
        !('refundStatus' in resource.data) &&
        d.refundStatus == 'due' &&
        d.refundAmount is number &&
        d.refundAmount > 0 &&
        d.refundAmount <= resource.data.price &&
        d.refundReason in ['customer_cancelled', 'customer_late_cancel', 'barber_cancelled',
          'shop_cancelled', 'admin_cancelled', 'request_declined', 'request_expired',
          'shop_deleted', 'system_cancelled'] &&
        isValidDateString(d.refundFlaggedAt);
    }

    // A live booking becomes cancelled (the allow statement checked the
    // status change). `ck` = the changed keys without the refund flag,
    // `flagged` = the update also adds the refund flag (refundFlagOk). The
    // slot locks are released in the same transaction (canReleaseSlotLock).
    function isBookingCancel(ck, flagged) {
      let d = request.resource.data;
      let r = resource.data;
      let by = d.get('cancelledBy', null);
      return (!flagged || refundFlagOk()) && (
        // The customer, before the shop's cutoff: {status, cancelledBy?
        // (own uid)}.
        (r.customerId == request.auth.uid &&
          ck.hasOnly(['status', 'cancelledBy']) &&
          (!ck.hasAny(['cancelledBy']) || by == request.auth.uid) &&
          r.status in ['pending', 'confirmed'] &&
          (!flagged || d.refundReason in ['customer_cancelled', 'customer_late_cancel']) &&
          beforeCutoff(r)) ||
        // Declining a request (the booked barber, the owner or an admin):
        // pending -> {status, cancelledBy: 'barber' | 'owner' (a role
        // literal), declineReason? (1..200)}.
        (r.status == 'pending' &&
          by in ['barber', 'owner'] &&
          ck.hasOnly(['status', 'cancelledBy', 'declineReason']) &&
          (!('declineReason' in d) || isString(d.declineReason, 1, 200)) &&
          canAnswerRequest()) ||
        // Staff cancel: the booked barber (only before the appointment
        // starts) or the owner, pending or confirmed, {status, cancelledBy:
        // own uid, cancelReasonNote? (1..200)}. cancelReasonNote can be
        // written only here.
        (by == request.auth.uid &&
          r.status in ['pending', 'confirmed'] &&
          ck.hasOnly(['status', 'cancelledBy', 'cancelReasonNote']) &&
          (!('cancelReasonNote' in d) || isString(d.cancelReasonNote, 1, 200)) &&
          ((isBarberProfile(r.shopId, r.barberId) &&
              (!('startAt' in r) || request.time < instantOf(r.startAt))) ||
            isOwnerOf(r.shopId))) ||
        // The owner or an admin cancels any live booking but a no-show:
        // {status, cancelledBy? (own uid)}; an admin may also correct
        // paymentStatus.
        (ck.hasOnly(['status', 'cancelledBy', 'paymentStatus']) &&
          (!ck.hasAny(['cancelledBy']) || by == request.auth.uid) &&
          r.status != 'noShow' &&
          ((!ck.hasAny(['paymentStatus']) && isOwnerOf(r.shopId)) ||
            ((!ck.hasAny(['paymentStatus']) || d.paymentStatus in ['unpaid', 'pending', 'paid', 'refunded']) &&
              isAdmin()))) ||
        // Admin clean-up: an upcoming booking of a shop being deleted
        // (shopDeletions/{shopId} exists) or of a disabled account:
        // {status, cancelledBy: own uid, cancelReason}.
        (ck.hasOnly(['status', 'cancelledBy', 'cancelReason']) &&
          by == request.auth.uid &&
          r.status in ['pending', 'confirmed'] &&
          (d.get('cancelReason', null) == 'account_disabled' ||
            (d.get('cancelReason', null) == 'shop_deleted' && exists(shopDeletionPath(r.shopId)))) &&
          isAdmin())
      );
    }

    function isCancelUpdate() {
      let ck = changedKeys();
      return isBookingCancel(ck.difference(refundFlagKeys().toSet()), ck.hasAny(refundFlagKeys()));
    }

    // Refund bookkeeping on a cancelled booking, by the shop's owner or an
    // admin: the late flag (a paid cancel that was not flagged: exactly
    // the four flag fields), or "mark refunded": refundStatus 'due' ->
    // 'refunded' with refundedAt (ISO), refundedBy (own uid), refundMethod,
    // refundReference? (1..100) and paymentStatus 'refunded' (left out
    // when it already is). The amount, reason and flag time never change.
    function isRefundBookkeeping() {
      let d = request.resource.data;
      let r = resource.data;
      let ck = d.diff(r).affectedKeys();
      return (
          (ck.hasOnly(refundFlagKeys()) && refundFlagOk()) ||
          (ck.hasOnly(['refundStatus', 'refundedAt', 'refundedBy', 'refundMethod', 'refundReference', 'paymentStatus']) &&
            r.get('refundStatus', '') == 'due' &&
            d.refundStatus == 'refunded' &&
            d.get('refundedBy', null) == request.auth.uid &&
            isIsoInstant(d.get('refundedAt', null)) &&
            d.get('refundMethod', null) in ['telebirr', 'cbe', 'bank', 'cash', 'chapa', 'other'] &&
            (!('refundReference' in d) || isString(d.refundReference, 1, 100)) &&
            d.get('paymentStatus', null) == 'refunded')
        ) &&
        (isOwnerOf(r.shopId) || isAdmin());
    }

    // The booked barber or the owner shares the barber's phone with the
    // customer on a confirmed or in-progress booking: exactly
    // {barberPhone}, the number in the barber's private contact.
    function isBarberPhoneShare() {
      let r = resource.data;
      let phone = request.resource.data.barberPhone;
      return r.status in ['confirmed', 'inProgress'] &&
        isEthiopianPhone(phone) &&
        (isBarberProfile(r.shopId, r.barberId) || isOwnerOf(r.shopId)) &&
        phone == get(barberContactPath(r.shopId, r.barberId)).data.phone;
    }

    // Any other status change (cancels go through isBookingCancel):
    // exactly status (an admin: also paymentStatus). The booked barber or
    // the owner runs a live booking (in progress, completed, no-show; see
    // statusTransitionOk); the owner may also rewrite a cancelled one as
    // cancelled; an admin may change either field.
    function isStatusUpdate() {
      let d = request.resource.data;
      let r = resource.data;
      let ck = d.diff(r).affectedKeys();
      return ck.hasOnly(['status', 'paymentStatus']) &&
        d.status in ['pending', 'confirmed', 'inProgress', 'completed', 'cancelled', 'noShow'] &&
        statusTransitionOk() &&
        (
          (ck.hasOnly(['status']) &&
            ((r.status != 'cancelled' && d.status != 'cancelled' &&
                (isBarberProfile(r.shopId, r.barberId) || isOwnerOf(r.shopId))) ||
              (r.status == 'cancelled' && d.status == 'cancelled' && isOwnerOf(r.shopId)))) ||
          ((!ck.hasAny(['paymentStatus']) || d.paymentStatus in ['unpaid', 'pending', 'paid', 'refunded']) &&
            isAdmin())
        );
    }

    // -----------------------------------------------------------------
    // Early finish (lib/services/early_finish_service.dart)
    // -----------------------------------------------------------------

    // Finishing: the booked barber, the shop's owner or an admin sets a
    // confirmed or in-progress booking to completed with exactly {status:
    // 'completed', completedAt (ISO, not more than an hour ahead of the
    // server clock)}. The slot locks stay. (Status-only completions still
    // go through the general branch.)
    function isCompleteBooking() {
      let d = request.resource.data;
      let r = resource.data;
      // Cheapest check first (shares the booking rule's expression budget).
      return d.status == 'completed' &&
        changedKeys().hasOnly(['status', 'completedAt']) &&
        r.status in ['confirmed', 'inProgress'] &&
        isIsoInstant(d.get('completedAt', null)) &&
        isoToTs(d.completedAt) <= request.time + duration.value(1, 'h') &&
        (isBarberProfile(r.shopId, r.barberId) || isOwnerOf(r.shopId) || isAdmin());
    }

    // Inbox notice users/{uid}/notifications/{bookingId}_early_{sourceBookingId}
    // created by the barber of the completed source booking or the shop's
    // owner, within an hour of completing it before its scheduled end, for
    // a confirmed booking of that customer with the same barber starting
    // later on the same Addis day.
    // The id is deterministic (one notice per pair); an existing doc (e.g.
    // written by functions/notifications) cannot be overwritten.
    function isValidEarlyFinishNotice(userId, noteId, d) {
      let s = get(bookingPath(d.sourceBookingId)).data;
      let b = get(bookingPath(d.bookingId)).data;
      return d.keys().hasOnly(['type', 'title', 'body', 'bookingId', 'shopId', 'barberId', 'sourceBookingId', 'minutesEarly', 'read', 'createdAt']) &&
        d.keys().hasAll(['type', 'title', 'body', 'bookingId', 'shopId', 'barberId', 'sourceBookingId', 'minutesEarly', 'read', 'createdAt']) &&
        d.type in ['barberFreeEarly', 'runningEarly'] &&
        isString(d.title, 1, 120) &&
        isString(d.body, 1, 500) &&
        d.read == false &&
        d.minutesEarly is int && d.minutesEarly >= 0 && d.minutesEarly <= 240 &&
        isString(d.bookingId, 1, 128) &&
        isString(d.sourceBookingId, 1, 128) &&
        d.bookingId != d.sourceBookingId &&
        noteId == d.bookingId + '_early_' + d.sourceBookingId &&
        (isBarberProfile(d.shopId, d.barberId) || isOwnerOf(d.shopId)) &&
        // The source booking was just completed by this barber.
        s.shopId == d.shopId &&
        s.barberId == d.barberId &&
        s.status == 'completed' &&
        isIsoInstant(s.get('completedAt', null)) &&
        d.createdAt == s.completedAt &&
        isoToTs(s.completedAt) >= request.time - duration.value(1, 'h') &&
        // ...before its scheduled end (an early finish).
        isoToTs(s.completedAt) < instantOf(s.endAt) &&
        // The recipient's own upcoming booking with the same barber, later
        // on the same Addis day as the finish.
        b.customerId == userId &&
        b.shopId == d.shopId &&
        b.barberId == d.barberId &&
        b.status == 'confirmed' &&
        instantOf(b.startAt) > request.time &&
        instantOf(b.startAt) > isoToTs(s.completedAt) &&
        addisDayOf(instantOf(b.startAt) + duration.value(3, 'h')) ==
          addisDayOf(isoToTs(s.completedAt) + duration.value(3, 'h'));
    }

    // -----------------------------------------------------------------
    // Inbox notices written by clients (users/{uid}/notifications). Each
    // id is deterministic (one notice per event) and a notice is only
    // created, never overwritten (an existing doc makes the set an
    // update, which only its owner may make, to mark it read).
    // -----------------------------------------------------------------

    // Refund notices to the booking's customer, in the write that changes
    // the booking's refund state: {type, title (1..200), body (1..500),
    // bookingId, read: false, createdAt (ISO)}.
    //  - refundDue, id {bookingId}_refundDue: the write flags the refund
    //    (whoever may flag it: see refundFlagOk);
    //  - paymentRefunded, id {bookingId}_paymentRefunded: the write marks it
    //    refunded (the shop's owner or an admin).
    function isValidRefundNotice(userId, noteId, d) {
      let p = bookingPath(d.bookingId);
      let before = get(p).data;
      let b = getAfter(p).data;
      return d.keys().hasOnly(['type', 'title', 'body', 'bookingId', 'read', 'createdAt']) &&
        d.keys().hasAll(['type', 'title', 'body', 'bookingId', 'read', 'createdAt']) &&
        d.title.matches('(?s)^.{1,200}$') &&
        d.body.matches('(?s)^.{1,500}$') &&
        d.read == false &&
        isIsoInstant(d.createdAt) &&
        b.customerId == userId &&
        noteId == d.bookingId + '_' + d.type &&
        (
          (d.type == 'refundDue' &&
            !('refundStatus' in before) && b.get('refundStatus', '') == 'due') ||
          (d.type == 'paymentRefunded' &&
            before.get('refundStatus', '') == 'due' && b.get('refundStatus', '') == 'refunded' &&
            (isOwnerOf(b.shopId) || isAdmin()))
        );
    }

    // The shop owner's notice of a new review, written by the reviewing
    // customer in the review's transaction: {type: 'newReview', title
    // (1..120), body (1..500), bookingId, shopId, barberId, rating, read:
    // false, createdAt (= the review's)}, id review_{bookingId}_{digits of
    // createdAt}. The reviewed barber's notice is written by
    // functions/notifications (Blaze) only.
    function isValidReviewNotice(userId, noteId, d) {
      let rv = /databases/$(database)/documents/barbershops/$(d.shopId)/reviews/$(d.bookingId);
      return d.keys().hasOnly(['type', 'title', 'body', 'bookingId', 'shopId', 'barberId', 'rating', 'read', 'createdAt']) &&
        d.keys().hasAll(['type', 'title', 'body', 'bookingId', 'shopId', 'barberId', 'rating', 'read', 'createdAt']) &&
        d.title.matches('(?s)^.{1,120}$') &&
        d.body.matches('(?s)^.{1,500}$') &&
        d.read == false &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        d.bookingId is string && d.shopId is string && d.barberId is string &&
        isIsoInstant(d.createdAt) &&
        noteId == 'review_' + d.bookingId + '_' + d.createdAt.replace('[^0-9]', '') &&
        !exists(rv) && existsAfter(rv) &&
        getAfter(rv).data.customerId == request.auth.uid &&
        getAfter(rv).data.barberId == d.barberId &&
        getAfter(rv).data.rating == d.rating &&
        getAfter(rv).data.createdAt == d.createdAt &&
        get(shopPath(d.shopId)).data.ownerId == userId;
    }

    // The customer's notice of a booking the booked barber or the owner
    // cancelled (e.g. for a vacation), written after that cancel by the
    // same person: {type: 'cancelled', title (1..120), body (1..500),
    // bookingId (1..128), read: false, createdAt (ISO)}, id
    // {bookingId}_cancelled.
    function isValidStaffCancelNotice(userId, noteId, d) {
      let b = get(bookingPath(d.bookingId)).data;
      return d.keys().hasOnly(['type', 'title', 'body', 'bookingId', 'read', 'createdAt']) &&
        d.keys().hasAll(['type', 'title', 'body', 'bookingId', 'read', 'createdAt']) &&
        d.title.matches('(?s)^.{1,120}$') &&
        d.body.matches('(?s)^.{1,500}$') &&
        d.bookingId.matches('^.{1,128}$') &&
        d.read == false &&
        isIsoInstant(d.createdAt) &&
        noteId == d.bookingId + '_cancelled' &&
        b.customerId == userId &&
        b.status == 'cancelled' &&
        b.get('cancelledBy', null) == request.auth.uid &&
        (isBarberProfile(b.shopId, b.barberId) || isOwnerOf(b.shopId));
    }

    // Admin clean-up notices (shop deletion, disabled accounts): {type,
    // title (1..120), body (1..500), shopId, bookingId?, read: false,
    // createdAt (ISO)}.
    //  - shopRemoved, id shopRemoved_{shopId}: to an owner or barber of
    //    that shop (downgraded in the same batch);
    //  - shopDeleted, id {bookingId}_shopDeleted: to the customer of a
    //    booking of that shop cancelled in the same batch (cancelReason
    //    'shop_deleted');
    //  - cancelled, id {bookingId}_accountDisabled: the same for a booking
    //    cancelled because its barber was disabled ('account_disabled').
    function isValidCleanupNotice(userId, noteId, d) {
      return isAdmin() &&
        d.keys().hasOnly(['type', 'title', 'body', 'shopId', 'bookingId', 'read', 'createdAt']) &&
        d.keys().hasAll(['type', 'title', 'body', 'shopId', 'read', 'createdAt']) &&
        d.title.matches('(?s)^.{1,120}$') &&
        d.body.matches('(?s)^.{1,500}$') &&
        d.read == false &&
        isIsoInstant(d.createdAt) &&
        d.shopId is string &&
        (
          (d.type == 'shopRemoved' &&
            !('bookingId' in d) &&
            noteId == 'shopRemoved_' + d.shopId &&
            get(userPath(userId)).data.get('shopId', '') == d.shopId) ||
          (d.type == 'shopDeleted' && isCleanupCancelNotice(userId, noteId, d, 'shop_deleted', '_shopDeleted')) ||
          (d.type == 'cancelled' && isCleanupCancelNotice(userId, noteId, d, 'account_disabled', '_accountDisabled'))
        );
    }

    function isCleanupCancelNotice(userId, noteId, d, reason, suffix) {
      let b = getAfter(bookingPath(d.bookingId)).data;
      return noteId == d.bookingId + suffix &&
        b.customerId == userId &&
        b.shopId == d.shopId &&
        b.status == 'cancelled' &&
        b.get('cancelReason', null) == reason;
    }

    // Which client-created notice this is, by its type (cheap checks
    // first; no nested ternaries: the emulator fails to explain a denial
    // through them).
    function isValidNewNotice(userId, noteId, d) {
      let t = d.get('type', '');
      return (t in ['barberFreeEarly', 'runningEarly'] && isValidEarlyFinishNotice(userId, noteId, d)) ||
        (t in ['refundDue', 'paymentRefunded'] && isValidRefundNotice(userId, noteId, d)) ||
        (t == 'newReview' && isValidReviewNotice(userId, noteId, d)) ||
        ((t in ['shopDeleted', 'shopRemoved'] || (t == 'cancelled' && 'shopId' in d)) &&
          isValidCleanupNotice(userId, noteId, d)) ||
        (t == 'cancelled' && !('shopId' in d) && isValidStaffCancelNotice(userId, noteId, d)) ||
        (t in ['receiptApproved', 'receiptRejected'] && isValidReceiptNotice(userId, noteId, d));
    }

    // -----------------------------------------------------------------
    // Subscription receipts (subscriptionPayments, platformConfig)
    // -----------------------------------------------------------------

    // Transaction-number shapes (normalized: uppercase, no spaces), as
    // isValidTransactionId in lib/services/subscription_pricing.dart.
    function isValidTransactionId(method, tx) {
      return tx is string && (
        (method == 'telebirr' && tx.matches('^[A-Z0-9]{8,12}$') && tx.matches('^.*[A-Z].*$')) ||
        (method == 'cbe' && tx.matches('^FT[A-Z0-9]{8,20}$')) ||
        (method == 'other' && tx.matches('^[A-Z0-9][A-Z0-9-]{3,39}$')));
    }

    // The owner's receipt (SubscriptionPayment.toCreateMap): 'pending',
    // no days granted yet, at {method}_{transactionId} so a transaction
    // can be claimed only once (a second create is an update, which owners
    // may not make). The photo: receiptImage, a base64 JPEG of at most
    // 350000 chars (free plan), or imagePath, the Storage object
    // receipts/{shopId}/{paymentId}.jpg (Blaze, storage.rules); not both.
    function isValidNewReceipt(paymentId, d) {
      return d.keys().hasOnly(['shopId', 'ownerId', 'method', 'transactionId', 'amount', 'status', 'durationDays', 'createdAt', 'receiptImage', 'payerAccountSuffix', 'imagePath']) &&
        d.keys().hasAll(['shopId', 'ownerId', 'method', 'transactionId', 'amount', 'status', 'durationDays', 'createdAt']) &&
        d.ownerId == request.auth.uid &&
        isString(d.shopId, 1, 128) &&
        isOwnerOf(d.shopId) &&
        get(shopPath(d.shopId)).data.ownerId == request.auth.uid &&
        d.method in ['telebirr', 'cbe', 'other'] &&
        isValidTransactionId(d.method, d.transactionId) &&
        paymentId == d.method + '_' + d.transactionId &&
        d.amount is number && d.amount > 0 && d.amount <= 1000000 &&
        d.status == 'pending' &&
        d.durationDays == 0 &&
        isIsoInstant(d.createdAt) &&
        isoToTs(d.createdAt) <= request.time + duration.value(1, 'h') &&
        isoToTs(d.createdAt) >= request.time - duration.value(1, 'd') &&
        (!('receiptImage' in d) || isString(d.receiptImage, 1, 350000)) &&
        (!('imagePath' in d) ||
          (!('receiptImage' in d) && d.imagePath == 'receipts/' + d.shopId + '/' + paymentId + '.jpg')) &&
        (!('payerAccountSuffix' in d) ||
          (d.method == 'cbe' && d.payerAccountSuffix is string && d.payerAccountSuffix.matches('^[0-9]{4,8}$')));
    }

    // A stored subscription end as a timestamp (now when missing/unreadable).
    function subscriptionEndOf(v) {
      return v is timestamp ? v : (isIsoInstant(v) ? isoToTs(v) : request.time);
    }

    // The shop `shop` (its data) is not past its grace period: no end date,
    // or less than 7 days (GRACE_DAYS) after it. Past it the shop counts
    // as suspended even while its stored status lags behind (free plan: no
    // daily function); the app blocks from end + 7 days on, too.
    function inGracePeriod(shop) {
      return shop.get('subscriptionEndsAt', null) == null ||
        request.time < subscriptionEndOf(shop.subscriptionEndsAt) + duration.value(7, 'd');
    }

    // Admin approval: exactly {status: 'verified', verifiedBy: own uid,
    // verifiedAmount, durationDays (1..1825), decidedAt}, in the batch that
    // makes the shop 'active' with subscriptionReceiptId = this receipt and
    // subscriptionEndsAt = max(now, current end) + durationDays (one day of
    // tolerance for the client clock).
    function isReceiptApprove(paymentId) {
      let d = request.resource.data;
      let before = get(shopPath(resource.data.shopId)).data;
      let shop = getAfter(shopPath(resource.data.shopId)).data;
      let base = subscriptionEndOf(before.get('subscriptionEndsAt', null));
      let from = base > request.time ? base : request.time;
      return changedKeys().hasOnly(['status', 'verifiedBy', 'verifiedAmount', 'durationDays', 'decidedAt']) &&
        d.status == 'verified' &&
        d.get('verifiedBy', null) == request.auth.uid &&
        d.get('verifiedAmount', null) is number &&
        d.verifiedAmount > 0 && d.verifiedAmount <= 1000000 &&
        d.get('durationDays', null) is int &&
        d.durationDays >= 1 && d.durationDays <= 1825 &&
        isIsoInstant(d.get('decidedAt', null)) &&
        shop.get('subscriptionReceiptId', null) == paymentId &&
        shop.get('subscriptionStatus', null) == 'active' &&
        isIsoInstant(shop.get('subscriptionEndsAt', null)) &&
        isoToTs(shop.subscriptionEndsAt) >= from + duration.value(d.durationDays - 1, 'd') &&
        isoToTs(shop.subscriptionEndsAt) <= from + duration.value(d.durationDays + 1, 'd');
    }

    // Admin rejection: exactly {status: 'rejected', verifiedBy: own uid,
    // decisionReason (1..300), decidedAt}. The shop is not touched.
    function isReceiptReject() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['status', 'verifiedBy', 'decisionReason', 'decidedAt']) &&
        d.status == 'rejected' &&
        d.get('verifiedBy', null) == request.auth.uid &&
        isString(d.get('decisionReason', null), 1, 300) &&
        isIsoInstant(d.get('decidedAt', null));
    }

    // The owner's inbox entry users/{ownerId}/notifications/{paymentId}_receipt,
    // written by the admin in the batch that decides that receipt.
    function isValidReceiptNotice(userId, noteId, d) {
      let p = getAfter(receiptPath(d.paymentId)).data;
      return isAdmin() &&
        d.keys().hasOnly(['title', 'body', 'type', 'read', 'createdAt', 'shopId', 'paymentId']) &&
        d.keys().hasAll(['title', 'body', 'type', 'read', 'createdAt', 'shopId', 'paymentId']) &&
        d.type in ['receiptApproved', 'receiptRejected'] &&
        isString(d.title, 1, 120) &&
        isString(d.body, 1, 500) &&
        d.read == false &&
        isIsoInstant(d.createdAt) &&
        isString(d.paymentId, 1, 200) &&
        noteId == d.paymentId + '_receipt' &&
        p.ownerId == userId &&
        p.shopId == d.shopId &&
        p.status == (d.type == 'receiptApproved' ? 'verified' : 'rejected') &&
        get(receiptPath(d.paymentId)).data.status in ['pending', 'needs_review'];
    }

    // A price tier {days: 1..1825, amount: 0 < ETB <= 1,000,000}; true
    // past the end of the list (rules cannot loop, so tiers 0..7 are
    // checked one by one).
    function isTierAt(tiers, i) {
      return tiers.size() <= i || (
        tiers[i] is map &&
        tiers[i].keys().hasOnly(['days', 'amount']) &&
        tiers[i].get('days', null) is int &&
        tiers[i].days >= 1 && tiers[i].days <= 1825 &&
        tiers[i].get('amount', null) is number &&
        tiers[i].amount > 0 && tiers[i].amount <= 1000000);
    }

    // A receiver {<idKey>: account or number, name (<= 80)}. The account is
    // '' (method not offered) or matches `pattern`; a set account needs a
    // name of at least 2 characters (payment_receivers.dart checkReceiver).
    // telebirr: an E.164 Ethiopian mobile; CBE: 13 digits starting 1000.
    // Neither pattern admits the 'XXXX' placeholder.
    function isReceiver(r, idKey, pattern) {
      return r is map &&
        r.keys().hasOnly([idKey, 'name']) &&
        r.get(idKey, null) is string &&
        isString(r.get('name', null), 0, 80) &&
        (r[idKey] == '' || (r[idKey].matches(pattern) && r.name.size() >= 2));
    }

    // A receipt link template: https, with an {id} placeholder.
    function isReceiptUrlTemplate(u) {
      return isString(u, 12, 500) && u.matches('^https://[^ ]*[{]id[}][^ ]*$');
    }

    // platformConfig/subscriptionPricing (SubscriptionPricing.toMap).
    // storageReceipts: true while owners' receipt photos go to Storage
    // (Blaze); absent otherwise.
    function isValidPricing(d) {
      return d.keys().hasOnly(['currency', 'tiers', 'receivers', 'receiptUrls', 'updatedAt', 'updatedBy', 'storageReceipts']) &&
        (!('storageReceipts' in d) || d.storageReceipts is bool) &&
        d.keys().hasAll(['currency', 'tiers', 'receivers']) &&
        d.currency == 'ETB' &&
        d.tiers is list && d.tiers.size() >= 1 && d.tiers.size() <= 8 &&
        isTierAt(d.tiers, 0) && isTierAt(d.tiers, 1) && isTierAt(d.tiers, 2) && isTierAt(d.tiers, 3) &&
        isTierAt(d.tiers, 4) && isTierAt(d.tiers, 5) && isTierAt(d.tiers, 6) && isTierAt(d.tiers, 7) &&
        d.receivers is map &&
        d.receivers.keys().hasOnly(['telebirr', 'cbe']) &&
        (!('telebirr' in d.receivers) || isReceiver(d.receivers.telebirr, 'number', '^[+]251[79][0-9]{8}$')) &&
        (!('cbe' in d.receivers) || isReceiver(d.receivers.cbe, 'account', '^1000[0-9]{9}$')) &&
        (!('receiptUrls' in d) ||
          (d.receiptUrls is map &&
            d.receiptUrls.keys().hasOnly(['telebirr', 'cbe']) &&
            (!('telebirr' in d.receiptUrls) || isReceiptUrlTemplate(d.receiptUrls.telebirr)) &&
            (!('cbe' in d.receiptUrls) || isReceiptUrlTemplate(d.receiptUrls.cbe)))) &&
        (!('updatedAt' in d) || isIsoInstant(d.updatedAt)) &&
        (!('updatedBy' in d) || d.updatedBy == request.auth.uid);
    }

    // -----------------------------------------------------------------
    // Payouts (barbershops/{shopId}/payouts)
    // -----------------------------------------------------------------

    function isUtcMidnight(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00[.]000Z$');
    }

    // Recorded by the owner for a barber of the shop. createdAt (client
    // clock) may not lie more than an hour in the future: it opens the
    // 24-hour delete window.
    function isValidNewPayout(shopId, d) {
      return d.keys().hasOnly(['barberId', 'amount', 'periodStart', 'periodEnd', 'method', 'note', 'createdBy', 'createdAt']) &&
        d.keys().hasAll(['barberId', 'amount', 'periodStart', 'periodEnd', 'method', 'createdBy', 'createdAt']) &&
        isString(d.barberId, 1, 128) &&
        d.amount is number && d.amount > 0 && d.amount <= 1000000 &&
        isUtcMidnight(d.periodStart) &&
        isUtcMidnight(d.periodEnd) &&
        d.periodStart <= d.periodEnd &&
        d.method in ['cash', 'telebirr', 'bank', 'other'] &&
        (!('note' in d) || isString(d.note, 1, 200)) &&
        d.createdBy == request.auth.uid &&
        isIsoInstant(d.createdAt) &&
        isoToTs(d.createdAt) <= request.time + duration.value(1, 'h') &&
        exists(barberPath(shopId, d.barberId));
    }

    // The signed-in barber whose barber profile `resource` pays (written so
    // the barber's `where barberId == own id` listener is provable).
    function isPaidBarber(shopId) {
      return isRole('barber') &&
        me().get('shopId', '') == shopId &&
        resource.data.barberId == me().get('barberId', '') &&
        exists(barberPath(shopId, me().get('barberId', '')));
    }

    // -----------------------------------------------------------------
    // Shop applications (shopApplications/{uid})
    // -----------------------------------------------------------------

    function addisSubCities() {
      return ['Addis Ketema', 'Akaky Kaliti', 'Arada', 'Bole', 'Gullele', 'Kirkos',
        'Kolfe Keranio', 'Lemi Kura', 'Lideta', 'Nifas Silk-Lafto', 'Yeka'];
    }

    // The fields the applicant fills in.
    function isValidApplicationFields(d) {
      return isString(d.ownerName, 1, 100) &&
        isString(d.shopName, 2, 80) &&
        isString(d.address, 2, 160) &&
        d.subCity in addisSubCities() &&
        isEthiopianContactPhone(d.phone) &&
        (!('description' in d) || isString(d.description, 1, 500));
    }

    // A new (or resubmitted) application: pending, no review fields, for
    // the caller's own uid and verified email.
    function isValidNewApplication(uid, d) {
      return d.keys().hasOnly(['uid', 'email', 'ownerName', 'shopName', 'address', 'subCity', 'phone', 'description', 'status', 'createdAt']) &&
        d.keys().hasAll(['uid', 'email', 'ownerName', 'shopName', 'address', 'subCity', 'phone', 'status', 'createdAt']) &&
        d.uid == uid &&
        myEmail() != '' &&
        d.email == myEmail() &&
        d.status == 'pending' &&
        isValidDateString(d.createdAt) &&
        isValidApplicationFields(d);
    }

    // Admin: pending -> rejected with exactly {status, reviewedBy,
    // reviewedAt, rejectReason}.
    function isApplicationReject() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectReason']) &&
        d.status == 'rejected' &&
        d.get('reviewedBy', null) == request.auth.uid &&
        isValidDateString(d.get('reviewedAt', null)) &&
        isString(d.get('rejectReason', null), 1, 300);
    }

    // Admin: pending -> approved with exactly {status, reviewedBy,
    // reviewedAt, shopId}, in the batch that creates the shop and the
    // applicant's owner invite for it.
    function isApplicationApprove() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'shopId']) &&
        d.status == 'approved' &&
        d.get('reviewedBy', null) == request.auth.uid &&
        isValidDateString(d.get('reviewedAt', null)) &&
        isString(d.get('shopId', null), 1, 128) &&
        existsAfter(shopPath(d.shopId)) &&
        getAfter(invitePath(resource.data.email)).data.get('shopId', '') == d.shopId &&
        getAfter(invitePath(resource.data.email)).data.role == 'barbershopOwner';
    }

    // -----------------------------------------------------------------
    // Shop deletion (admin; see the shopDeletions match)
    // -----------------------------------------------------------------

    function isValidShopDeletion(shopId, d) {
      return d.keys().hasOnly(['shopId', 'shopName', 'requestedBy', 'requestedAt', 'staffUids', 'barberAccountUids',
          'serverCleanupAt', 'deletedLogins']) &&
        d.keys().hasAll(['shopId', 'shopName', 'requestedBy', 'requestedAt', 'staffUids', 'barberAccountUids']) &&
        d.shopId == shopId &&
        isString(d.shopName, 0, 200) &&
        d.requestedBy == request.auth.uid &&
        isIsoInstant(d.requestedAt) &&
        d.staffUids is list && d.staffUids.size() <= 500 &&
        d.barberAccountUids is list && d.barberAccountUids.size() <= 500 &&
        // The server's fields are never written by clients.
        (resource == null
          ? !d.keys().hasAny(['serverCleanupAt', 'deletedLogins'])
          : !d.diff(resource.data).affectedKeys().hasAny(['serverCleanupAt', 'deletedLogins']));
    }

    // An admin clearing the subcollections of a shop being deleted.
    function isShopDeletionCleanup(shopId) {
      return isAdmin() && exists(shopDeletionPath(shopId));
    }

    // -----------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------
    match /users/{userId} {
      // Own profile; admins see everyone; owners see their shop's staff.
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.get('shopId', null) is string && isOwnerOf(resource.data.shopId))
      );

      // First sign-in: create your own profile with your verified Google
      // email (lowercased) and a contact phone you type in. The role is
      // `customer`, or whatever your invite says.
      //
      // Barber accounts: a login the shop owner created (email not verified
      // yet) creates its profile only from the invite at its token email
      // whose authUid is its uid (matchesInvite); its email is the token
      // email, lowercased. mustChangePassword is copied from the invite.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        isValidNewProfile(request.resource.data);

      allow update: if signedIn() && isValidUser(request.resource.data) && (
        isAdmin() ||
        (request.auth.uid == userId &&
          unchanged('uid') && unchanged('createdAt') && unchanged('email') &&
          (
            // Ordinary profile edits: name, language, contact phone.
            changedKeys().hasOnly(['name', 'language', 'phone']) ||
            // Barber accounts: the forced password change clears the flag
            // (it can never be set again by the user).
            (changedKeys().hasOnly(['mustChangePassword']) &&
              request.resource.data.mustChangePassword == false) ||
            // ...or a customer accepting an invite (one time).
            (resource.data.role == 'customer' &&
              !changedKeys().hasAny(disabledKeys()) &&
              matchesMyInvite(request.resource.data))
          ))
      );

      allow delete: if isAdmin();

      // FCM registration tokens of this user's devices.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          deviceId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          isValidDevice(request.resource.data);
      }

      // In-app inbox, written by Cloud Functions. The user may only mark
      // a notification as read. Clients create some kinds (never update or
      // delete them, see isValidNewNotice): early-finish notices (staff),
      // receipt decisions (admin), refund notices, the owner's new-review
      // notice (the reviewing customer), staff-cancel notices and the
      // admin's shop-deletion / disabled-account notices.
      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() &&
          isValidNewNotice(userId, notificationId, request.resource.data);
        allow update: if signedIn() &&
          request.auth.uid == userId &&
          changedKeys().hasOnly(['read']) &&
          request.resource.data.read == true;
      }
    }

    // -----------------------------------------------------------------
    // invites/{email}
    // -----------------------------------------------------------------
    match /invites/{email} {
      // An unverified login the owner created reads (and consumes) only
      // the invite naming its uid in authUid.
      allow read: if signedIn() && (
        (myEmail() != '' && myEmail() == email) ||
        resource.data.get('authUid', null) == request.auth.uid ||
        isAdmin() ||
        (resource.data.role == 'barber' && isOwnerOf(resource.data.shopId))
      );

      allow create: if signedIn() &&
        isValidInvite(request.resource.data, email) &&
        (
          isAdmin() ||
          (request.resource.data.role == 'barber' && isOwnerOf(request.resource.data.shopId))
        );

      // Owners may only replace their own shop's barber invites.
      allow update: if signedIn() &&
        isValidInvite(request.resource.data, email) &&
        (
          isAdmin() ||
          (request.resource.data.role == 'barber' && isOwnerOf(request.resource.data.shopId) &&
            resource.data.role == 'barber' && isOwnerOf(resource.data.shopId))
        );

      // The invitee (accepting/declining), an admin, or the shop owner
      // (cancelling a barber invite).
      allow delete: if signedIn() && (
        (myEmail() != '' && myEmail() == email) ||
        resource.data.get('authUid', null) == request.auth.uid ||
        isAdmin() ||
        (resource.data.role == 'barber' && isOwnerOf(resource.data.shopId))
      );
    }

    // -----------------------------------------------------------------
    // Collection-group reads (customer and admin listeners). Services and
    // barber profiles are public, like the nested rules below. These do
    // not match slotLocks (a different collection id).
    // -----------------------------------------------------------------
    match /{path=**}/services/{serviceId} {
      allow read: if true;
    }

    match /{path=**}/barbers/{barberId} {
      allow read: if true;
    }

    // -----------------------------------------------------------------
    // barbershops/{shopId}
    // -----------------------------------------------------------------
    match /barbershops/{shopId} {
      // Public directory of shops that are not suspended. A suspended shop
      // stays visible to its own staff and to admins. An admin-suspended
      // shop stays readable (the app shows it as "temporarily unavailable",
      // and the customer query cannot filter on a missing field); it takes
      // no bookings (isBookable, isValidReschedule) or remote queue joins.
      allow read: if isCustomerVisibleShop(resource.data) || isAdmin() || isStaffOf(shopId);

      // Shops are onboarded by the platform admin, with no reviews yet,
      // not suspended and without a receipt link.
      allow create: if isAdmin() && isValidBarbershop(request.resource.data) &&
        request.resource.data.get('reviewCount', 0) == 0 &&
        !request.resource.data.keys().hasAny(['adminSuspended', 'adminSuspendedReason', 'adminSuspendedAt', 'adminSuspendedBy', 'subscriptionReceiptId']);

      // Owners edit their shop's profile and booking policy
      // (cancellationCutoffHours, maxReschedules) but cannot verify it,
      // change its rating or its subscription. They can claim an unowned
      // shop (ownerId '') once. rating/reviewCount are written by
      // functions/insights only, so not even the admin changes them.
      // The admin edits the profile, verification and subscription
      // (admin_shop_edit_screen), suspends / reactivates the shop
      // (adminSuspensionOk) and links an approved receipt (receiptLinkOk).
      // The opening hours (openingHour, closingHour, workingDays) are set
      // by the shop owner only: an admin update must leave them unchanged
      // (the admin create may still set the defaults).
      //
      // Free plan: the owner's app records its own lapsed period
      // (isSubscriptionLapse).
      //
      // Each update validates only the fields it changes (the stored ones
      // were validated when written): see isAdminShopUpdate and
      // isOwnerShopUpdate.
      allow update: if changedKeys().hasOnly(['subscriptionStatus', 'subscriptionStatusChangedAt']) &&
        isOwnerOf(shopId) &&
        isSubscriptionLapse();
      allow update: if isAdmin() && isAdminShopUpdate(shopId);
      allow update: if isOwnerOf(shopId) && isOwnerShopUpdate();

      allow delete: if isAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow create: if canManageShop(shopId) && isValidService(request.resource.data, shopId);
        allow update: if canManageShop(shopId) && isValidService(request.resource.data, shopId);
        allow delete: if canManageShop(shopId);
      }

      match /barbers/{barberId} {
        allow read: if true;

        // New barbers have no reviews yet, and no phone or email: the
        // barber's phone lives in private/contact (not public).
        allow create: if canManageShop(shopId) && isValidBarber(request.resource.data, shopId) &&
          request.resource.data.get('reviewCount', 0) == 0 &&
          request.resource.data.get('ratingSum', 0) == 0 &&
          !('lastReviewId' in request.resource.data) &&
          request.resource.data.get('phone', null) == null &&
          request.resource.data.get('email', null) == null;

        // The rating counters (ratingSum, reviewCount, lastReviewId) change
        // only with a review created, edited or deleted by its customer in
        // the same transaction (isReviewCounterUpdate); nobody else changes
        // them or the legacy rating.
        allow update: if signedIn() &&
          changedKeys().hasOnly(['ratingSum', 'reviewCount', 'lastReviewId']) &&
          isReviewCounterUpdate(shopId, barberId);

        // A barber toggles their own availability.
        allow update: if changedKeys().hasOnly(['isAvailable']) &&
          request.resource.data.isAvailable is bool &&
          isBarberProfile(shopId, barberId);

        // Owners manage profiles, working hours and commission
        // (commissionPercent, owner only) but not ratings; admins the same
        // but the commission. A phone or email on an old public doc may
        // stay or be removed (moved to private/contact), never be added
        // or changed.
        allow update: if isValidBarber(request.resource.data, shopId) &&
          (!changedKeys().hasAny(['phone']) || request.resource.data.get('phone', null) == null) &&
          (!changedKeys().hasAny(['email']) || request.resource.data.get('email', null) == null) && (
          (isAdmin() && !changedKeys().hasAny(['rating', 'reviewCount', 'ratingSum', 'lastReviewId', 'commissionPercent'])) ||
          (isOwnerOf(shopId) && !changedKeys().hasAny(['rating', 'reviewCount', 'ratingSum', 'lastReviewId']))
        );

        allow delete: if canManageShop(shopId);

        // The barber's phone, {phone} at private/contact: only the shop's
        // owner, admins and that barber read or write it (customers get
        // it on a confirmed booking: bookings barberPhone). Written in the
        // batches that add, move or delete the barber, or alone.
        match /private/{docId} {
          allow read, delete: if signedIn() &&
            (canManageShop(shopId) || isBarberProfile(shopId, barberId));
          allow create, update: if docId == 'contact' &&
            signedIn() &&
            request.resource.data.keys().hasOnly(['phone']) &&
            isEthiopianPhone(request.resource.data.get('phone', null)) &&
            (canManageShop(shopId) || isBarberProfile(shopId, barberId));
        }

        // Double-booking prevention: one lock per 15-minute block of a
        // booking, created in the same transaction as the booking. Locks
        // are never updated, so a second booking for a taken block fails.
        match /slotLocks/{lockId} {
          // The booking screen reads a day's locks to show busy times.
          // Locks hold only a booking id and two instants.
          allow read: if signedIn();

          // Booking locks (bookingId) and time-off locks (timeOffId).
          allow create: if signedIn() && (
            'timeOffId' in request.resource.data
              ? canCreateTimeOffLock(shopId, barberId, lockId, request.resource.data)
              : canCreateSlotLock(shopId, barberId, lockId, request.resource.data)
          );

          allow update: if false;

          // Released when the booking is cancelled or moved; owners and
          // admins may clear their shop's locks at any time; the barber
          // releases their time-off locks together with the time-off doc.
          allow delete: if signedIn() && (
            ('bookingId' in resource.data && canReleaseSlotLock(shopId, barberId)) ||
            ('timeOffId' in resource.data &&
              isBarberProfile(shopId, barberId) &&
              !existsAfter(timeOffPath(shopId, barberId, resource.data.timeOffId))) ||
            canManageShop(shopId)
          );
        }

        // Barber time off. Created and deleted in one batch with its slot
        // locks, by the shop's owner or that barber. Customers never read
        // it (they see the locks).
        match /timeOff/{timeOffId} {
          allow read: if canManageTimeOff(shopId, barberId) || isShopDeletionCleanup(shopId);

          allow create: if canManageTimeOff(shopId, barberId) &&
            isValidNewTimeOff(shopId, barberId, timeOffId, request.resource.data);

          allow update: if false;

          // Its first and last locks go in the same batch (the app deletes
          // every lock with timeOffId == this id).
          allow delete: if canManageTimeOff(shopId, barberId) &&
            releasedTimeOffLock(shopId, barberId, timeOffId, utcMinuteToTs(resource.data.startAt)) &&
            releasedTimeOffLock(shopId, barberId, timeOffId,
              utcMinuteToTs(resource.data.endAt) - duration.value(15, 'm'));
          allow delete: if isShopDeletionCleanup(shopId);
        }
      }

      // Walk-in queue. Staff (owner, barbers of the shop) run it; signed-in
      // customers may join remotely with their own phone and leave their
      // own waiting entry. Entries are never deleted.
      match /queue/{entryId} {
        allow read: if signedIn() && (
          resource.data.addedBy == request.auth.uid ||
          isQueueStaffOf(shopId) ||
          isShopDeletionCleanup(shopId)
        );

        allow create: if signedIn() &&
          isValidNewQueueEntry(shopId, request.resource.data) &&
          (
            (request.resource.data.source == 'walkIn' && isQueueStaffOf(shopId)) ||
            (request.resource.data.source == 'remote' &&
              isRole('customer') &&
              me().get('disabled', false) != true &&
              (!('phone' in request.resource.data) || request.resource.data.phone == me().phone) &&
              shopDataOf(shopId).get('subscriptionStatus', 'trialing') != 'suspended' &&
              shopDataOf(shopId).get('adminSuspended', false) != true &&
              inGracePeriod(shopDataOf(shopId)) &&
              exists(shopPath(shopId)))
          );

        allow update: if signedIn() && (
          (resource.data.addedBy == request.auth.uid &&
            resource.data.source == 'remote' &&
            isQueueFinish('waiting', 'left')) ||
          (isQueueStaffOf(shopId) &&
            (isQueueStartServing(shopId) ||
              isQueueFinish('serving', 'done') ||
              isQueueFinish('waiting', 'left')))
        );

        allow delete: if isShopDeletionCleanup(shopId);
      }

      // Maintained by functions/queue; public. On the free plan the staff
      // app writes `current` itself (queue_summary_writer.dart, a plain set
      // with the function's exact shape).
      match /queueSummary/{docId} {
        allow read: if true;
        allow create, update: if docId == 'current' && signedIn() &&
          isValidQueueSummary(request.resource.data) &&
          isQueueStaffOf(shopId);
        allow delete: if isShopDeletionCleanup(shopId);
      }

      // Public reviews. The booking's customer creates one per completed
      // booking (doc id = bookingId), and may edit its stars and comment
      // or delete it, each in one transaction with the barber's counters
      // (isReviewCounterUpdate). The shop's owner may only add or edit the
      // reply. A disabled account writes no new review.
      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn() &&
          me().get('disabled', false) != true &&
          isValidNewReview(shopId, reviewId, request.resource.data);

        allow update: if isOwnerOf(shopId) &&
          changedKeys().hasOnly(['reply', 'replyAt']) &&
          isString(request.resource.data.get('reply', null), 1, 500) &&
          isValidDateString(request.resource.data.get('replyAt', null));

        allow update: if signedIn() &&
          resource.data.customerId == request.auth.uid &&
          changedKeys().hasOnly(['rating', 'comment', 'editedAt']) &&
          isReviewEdit(shopId, reviewId);

        // Its customer (the barber's counters drop in the same write), or
        // an admin deleting the shop.
        allow delete: if signedIn() &&
          resource.data.customerId == request.auth.uid &&
          (!exists(barberPath(shopId, resource.data.barberId)) ||
            barberCountersAfter(barberPath(shopId, resource.data.barberId), reviewId, -resource.data.rating, -1));
        allow delete: if isAdmin() && exists(shopDeletionPath(shopId));
      }

      // Aggregates written by functions/insights only.
      match /stats/{month} {
        allow read: if canManageShop(shopId);
        allow create, update: if false;
        allow delete: if isShopDeletionCleanup(shopId);
      }

      match /clients/{customerId} {
        allow read: if canManageShop(shopId);
        allow create, update: if false;
        allow delete: if isShopDeletionCleanup(shopId);
      }

      // Barber payouts. The owner records them (never edits) and may
      // delete one within 24 hours of its createdAt. The barber reads
      // their own (listener: where barberId == own barber id).
      match /payouts/{payoutId} {
        allow read: if signedIn() && (canManageShop(shopId) || isPaidBarber(shopId));
        allow create: if isOwnerOf(shopId) && isValidNewPayout(shopId, request.resource.data);
        allow update: if false;
        allow delete: if isOwnerOf(shopId) &&
          isIsoInstant(resource.data.get('createdAt', null)) &&
          request.time < isoToTs(resource.data.createdAt) + duration.value(24, 'h');
        allow delete: if isShopDeletionCleanup(shopId);
      }
    }

    // -----------------------------------------------------------------
    // shopApplications/{uid} - a customer applies to register a shop
    // -----------------------------------------------------------------
    match /shopApplications/{uid} {
      // The applicant (any role: they become an owner on approval) and
      // admins. Admin listeners: where status == 'pending', and orderBy
      // reviewedAt desc limit n.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() &&
        request.auth.uid == uid &&
        isRole('customer') &&
        me().get('disabled', false) != true &&
        isValidNewApplication(uid, request.resource.data);

      allow update: if signedIn() && (
        (request.auth.uid == uid && isRole('customer') &&
          (
            // Apply again after a rejection (set() overwrites it).
            (resource.data.status == 'rejected' && isValidNewApplication(uid, request.resource.data)) ||
            // Edit while pending: only the fields the applicant fills in.
            (resource.data.status == 'pending' &&
              changedKeys().hasOnly(['ownerName', 'shopName', 'address', 'subCity', 'phone', 'description']) &&
              isValidApplicationFields(request.resource.data))
          )) ||
        (isAdmin() && resource.data.status == 'pending' &&
          (isApplicationReject() || isApplicationApprove()))
      );

      // Withdraw while pending.
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.status == 'pending';
    }

    // -----------------------------------------------------------------
    // bookings/{bookingId}
    // -----------------------------------------------------------------
    match /bookings/{bookingId} {
      // Admins may open a single booking (e.g. from a payment) but no longer
      // list them: the admin dashboard has no bookings list.
      allow get: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        canManageShop(resource.data.shopId) ||
        isBarberProfile(resource.data.shopId, resource.data.barberId)
      );

      // Listeners: customer (customerId == uid), owner (shopId == own
      // shop), barber (shopId == S and barberId == own profile). Admins:
      // refunds due, and the upcoming bookings of a shop being deleted or
      // of an account being disabled.
      allow list: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isOwnerOf(resource.data.shopId) ||
        isBarberProfile(resource.data.shopId, resource.data.barberId) ||
        isAdmin()
      );

      // Customers book for themselves, with an available barber and a
      // service of a non-suspended shop, at the service's real price and
      // duration, holding the slot locks for the appointment.
      // An account an admin disabled (users/{uid}.disabled) books nothing;
      // me() also fails without a profile.
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        me().get('disabled', false) != true &&
        isValidNewBooking(request.resource.data, bookingId) &&
        isBookable(request.resource.data);

      // Only the status (plus who cancelled) changes after booking.
      // Payment fields and reminder flags belong to Cloud Functions; an
      // admin may also correct paymentStatus.
      //
      // noShow: set by the assigned barber, the owner or an admin once the
      // appointment has started, from pending/confirmed only (see
      // statusTransitionOk); its slot locks are kept.
      //
      // The customer may also move the booking (isValidReschedule), in one
      // transaction with its slot locks.
      //
      // The reschedule statement comes first and validates only the fields
      // it may change (the rest is unchanged).
      //
      // Cancels (isBookingCancel): the customer before the cutoff; a
      // declined request (the booked barber, the owner or an admin; see
      // also isAcceptRequest); the staff cancel (the booked barber before
      // the start, or the owner: cancelledBy = own uid, optional
      // cancelReasonNote; barbers have no other way to cancel); the owner
      // or an admin; and the admin clean-up (shop deletion, disabled
      // accounts: cancelReason).
      //
      // Finishing (isCompleteBooking): staff write {status: 'completed',
      // completedAt}; an early finish then notifies the barber's next
      // customers (users/{uid}/notifications, isValidEarlyFinishNotice).
      //
      // Every statement validates only what it lets change: every other
      // field is unchanged and was valid when it was written.
      //
      // barberPhone (isBarberPhoneShare): the booked barber or the owner
      // copies the barber's private phone to a confirmed booking, for its
      // customer. Never on create, never by the customer.
      //
      // Refunds (functions/bookings keeps payments/*): a cancel of a paid
      // booking adds the refund flag in the same update (isBookingCancel,
      // refundFlagOk); the owner or an admin flags a missed one later and
      // marks it refunded (isRefundBookkeeping).
      //
      // One statement per kind of update, each behind a cheap check of
      // what changes; the heaviest (reschedule) first.
      allow update: if signedIn() &&
        changedKeys().hasOnly(['startAt', 'endAt', 'date', 'timeSlot', 'rescheduleCount', 'rescheduledAt']) &&
        isValidReschedule(bookingId);

      allow update: if request.resource.data.status == 'cancelled' &&
        resource.data.status != 'cancelled' &&
        signedIn() &&
        isCancelUpdate();

      allow update: if resource.data.status == 'cancelled' &&
        signedIn() &&
        isRefundBookkeeping();

      allow update: if changedKeys().hasOnly(['barberPhone']) &&
        signedIn() &&
        isBarberPhoneShare();

      allow update: if signedIn() && (
        isAcceptRequest() ||
        isCompleteBooking() ||
        isStatusUpdate()
      );

      // Bookings are kept for history.
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // shopDeletions/{shopId} - an admin deleting a shop records it first
    // (set with merge, on every run of the clean-up): shopId (== doc id),
    // shopName, requestedBy (own uid), requestedAt (ISO), staffUids and
    // barberAccountUids (uid lists). functions/auth (Blaze) adds
    // serverCleanupAt / deletedLogins. While it exists, an admin may
    // delete the shop's subcollections (isShopDeletionCleanup) and cancel
    // its upcoming bookings (isBookingCancel).
    // -----------------------------------------------------------------
    match /shopDeletions/{shopId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidShopDeletion(shopId, request.resource.data);
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // plans/{planId} - subscription plans
    // -----------------------------------------------------------------
    match /plans/{planId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPlan(request.resource.data);
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------
    // payments/{paymentId} - written by Cloud Functions only
    // -----------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        canManageShop(resource.data.shopId)
      );
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // subscriptionPayments/{method}_{transactionId} - owners' transfer
    // receipts. Works without Cloud Functions: an admin checks the receipt
    // and approves it (one batch with the shop's subscription and the
    // owner's inbox entry) or rejects it. functions/payments may verify
    // them automatically with the Admin SDK once deployed.
    // -----------------------------------------------------------------
    match /subscriptionPayments/{paymentId} {
      // The owner checks a transaction id before submitting: a missing doc
      // reads as "free", someone else's is denied (= already claimed).
      allow get: if signedIn() && (
        resource == null
          ? (isRole('barbershopOwner') || isAdmin())
          : (resource.data.ownerId == request.auth.uid || isAdmin())
      );

      // Owner: where ownerId == uid. Admin: where status in [open
      // statuses], and orderBy decidedAt desc limit n.
      allow list: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if signedIn() && isValidNewReceipt(paymentId, request.resource.data);

      // Only an admin decides, once, while the receipt is open. Owners
      // cannot change anything after submitting.
      allow update: if isAdmin() &&
        resource.data.status in ['pending', 'needs_review'] &&
        (isReceiptApprove(paymentId) || isReceiptReject());

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // platformConfig/subscriptionPricing - subscription prices and where
    // owners pay. Other platformConfig docs are closed.
    // -----------------------------------------------------------------
    match /platformConfig/{docId} {
      allow read: if docId == 'subscriptionPricing' && (isRole('barbershopOwner') || isAdmin());
      allow create, update: if docId == 'subscriptionPricing' && isAdmin() && isValidPricing(request.resource.data);
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // emailCodes/* and authRateLimits/* - functions/auth only. They hold
    // code hashes and send counters for email registration and password
    // reset; clients must never read or write them.
    // -----------------------------------------------------------------
    match /emailCodes/{docId=**} {
      allow read, write: if false;
    }

    match /authRateLimits/{docId=**} {
      allow read, write: if false;
    }

    // Written by functions/auth (onInviteCreated) only.
    match /inviteEmails/{docId=**} {
      allow read, write: if false;
    }

    // notificationLog/* and everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
